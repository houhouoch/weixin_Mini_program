.apple6 .minimal-balance__amount.amount-normal { font-size: 108rpx; }
.apple6 .minimal-balance__amount.amount-medium { font-size: 88rpx; }
.apple6 .minimal-balance__amount.amount-small { font-size: 66rpx; }
.apple-daily-metrics { display:flex; flex-wrap:wrap; gap:12rpx 38rpx; margin-top: 6rpx; font-size:25rpx; line-height:38rpx; color:var(--theme-muted); }
.apple-progress { margin-top:30rpx; height:10rpx; border-radius:999rpx; background:var(--theme-control); overflow:hidden; }
.apple-progress__fill { height:100%; border-radius:inherit; background:var(--theme-primary); transition: width 240ms ease-out; }
.apple-cycle { display:flex; align-items:center; justify-content:space-between; gap:12rpx; color:var(--theme-muted); font-size:23rpx; line-height:32rpx; }
