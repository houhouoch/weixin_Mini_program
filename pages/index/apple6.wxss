/* Approved Apple 6.0: semantic surfaces, system type, native layout. */
.apple6 { padding: 24rpx 46rpx calc(210rpx + env(safe-area-inset-bottom)); }
.apple6 button { transition: transform 180ms ease-out, opacity 180ms ease-out, background-color 180ms ease-out; }
.apple6 button:active { opacity: .75; transform: scale(.98); }
.apple6 button[disabled] { opacity: .4; }
.apple6 .minimal-title { font-size: 50rpx; line-height: 72rpx; letter-spacing: -1rpx; }
.apple6 .minimal-date { font-size: 25rpx; line-height: 38rpx; }
.apple-date-status { min-height: 54rpx; }
.apple-status { padding: 10rpx 26rpx; border-radius: 999rpx; background: var(--theme-control); color: var(--theme-success); font-size: 22rpx; line-height: 32rpx; }
.apple-status--todayOverspent,.apple-status--monthOverspent,.apple-status--budgetUnavailable { color: var(--status-danger); }
.apple-status--runningLow { color: #996800; }
.apple6--dark .apple-status--runningLow { color: #FFD60A; }
