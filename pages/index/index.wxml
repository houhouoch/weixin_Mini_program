<view class="page-shell">
  <view class="share-entry" wx:if="{{fromShare && viewState !== 'ready'}}">
    <text class="share-entry__eyebrow">朋友分享给你一个简单的预算方法</text>
    <text class="share-entry__title">开始我的支出记录</text>
    <text class="share-entry__copy">数据只会保存在你自己的设备中。</text>
  </view>

  <view class="page-topbar">
    <view class="page-topbar__copy">
      <text class="page-title">今天还能花</text>
      <text class="date-label">{{dateLabel}}</text>
    </view>
    <button
      wx:if="{{viewState === 'ready'}}"
      class="settings-button"
      bindtap="openSettings"
      aria-label="修改本月设置"
    >设置</button>
  </view>

  <view class="loading-card" wx:if="{{viewState === 'loading'}}">
    <view class="skeleton skeleton-short"></view>
    <view class="skeleton skeleton-amount"></view>
    <view class="skeleton skeleton-copy"></view>
  </view>

  <view class="error-card" wx:if="{{viewState === 'readError'}}">
    <text class="error-card__title">暂时没读到本地数据</text>
    <text class="error-card__copy">{{readMessage}}</text>
    <button class="secondary-button" bindtap="refreshPage">重新读取</button>
  </view>

  <block wx:if="{{viewState === 'ready'}}">
    <view class="hero-card">
      <image
        class="hero-art"
        src="/assets/images/spending-journey-hero-v2.png"
        mode="aspectFill"
        aria-label="由咖啡、交通、购物和小票组成的日常消费插画"
      />
      <view class="hero-copy-paper"></view>
      <view class="hero-content">
        <text class="hero-eyebrow">今天还能花</text>
        <view class="hero-amount {{amountSizeClass}}">
          <text class="hero-currency">¥</text>
          <text>{{result.todayRemainingText}}</text>
        </view>
        <text class="hero-status">可以从容花，也知道花去了哪里</text>
        <text class="hero-badge">{{result.persona}}</text>
      </view>
    </view>

    <view class="budget-rail budget-rail--{{statusTone}}">
      <view class="budget-rail__labels">
        <text>今天已花 ¥{{result.todaySpentText}}</text>
        <text>本月可用 ¥{{result.monthlyRemainingText}}</text>
      </view>
      <view class="budget-rail__track">
        <view class="budget-rail__spent" style="width: {{result.spentProgressPercent}}%;"></view>
      </view>
      <text class="budget-rail__helper">建议额度 ¥{{result.todaySuggestedBudgetText}} · {{result.statusText}}</text>
    </view>

    <view class="record-composer">
      <text class="composer-title">这笔花在哪儿？</text>
      <text class="composer-copy">先选分类，再补一句用途；不想写也可以直接记。</text>

      <view class="category-grid" role="list">
        <button
          wx:for="{{categories}}"
          wx:key="id"
          class="category-chip {{selectedCategoryId === item.id ? 'category-chip--selected' : ''}}"
          data-id="{{item.id}}"
          bindtap="handleCategorySelect"
          aria-label="选择{{item.label}}分类"
        >{{item.label}}</button>
      </view>

      <text class="composer-label">用途（可选）</text>
      <input
        class="purpose-field"
        type="text"
        value="{{noteInput}}"
        placeholder="例如：咖啡、午餐、地铁"
        maxlength="20"
        bindinput="handleNoteInput"
        aria-label="填写消费用途"
      />

      <view class="composer-action-row">
        <view class="composer-amount {{inputError ? 'composer-field--error' : ''}}">
          <text>¥</text>
          <input
            class="composer-amount__input"
            type="digit"
            value="{{amountInput}}"
            placeholder="15.00"
            maxlength="10"
            bindinput="handleAmountInput"
            confirm-type="done"
            aria-label="输入本次消费金额"
          />
        </view>
        <button
          class="composer-save {{isSaving ? 'composer-save--loading' : ''}}"
          bindtap="handleAddTransaction"
          disabled="{{isSaving}}"
          loading="{{isSaving}}"
        >{{isSaving ? '保存中…' : '记下这笔'}}</button>
      </view>
      <view class="composer-feedback" wx:if="{{inputError || feedback}}">
        <text class="field-error" aria-role="alert" wx:if="{{inputError}}">{{inputError}}</text>
        <text class="field-success" aria-role="status" wx:if="{{feedback}}">{{feedback}}</text>
      </view>
    </view>

    <view class="receipt-card">
      <view class="receipt-header">
        <view class="receipt-header__copy">
          <text class="receipt-eyebrow">SPENDING RECEIPT · 最近记录</text>
          <text class="receipt-title">最近花去了哪里</text>
        </view>
        <text class="receipt-count">{{transactions.length}} 笔</text>
      </view>
      <view class="receipt-perforation"></view>

      <view class="empty-records" wx:if="{{recentTransactions.length === 0}}">
        <text class="empty-records__title">今天还没有小票</text>
        <text class="empty-records__copy">选一个分类，记下第一笔去向。</text>
      </view>

      <view class="record-list" wx:else>
        <view class="record-row" wx:for="{{recentTransactions}}" wx:key="id">
          <text class="record-tag record-tag--{{item.categoryId}}">{{item.categoryLabel}}</text>
          <view class="record-main">
            <text class="record-purpose">{{item.purposeText}}</text>
            <text class="record-time">{{item.occurredAtText}}</text>
          </view>
          <view class="record-tail">
            <text class="record-amount">- ¥{{item.amountText}}</text>
            <button
              class="delete-button"
              data-id="{{item.id}}"
              bindtap="handleDeleteTransaction"
              aria-label="删除{{item.categoryLabel}}{{item.purposeText}}这笔消费"
            >删除</button>
          </view>
        </view>
      </view>
      <text class="receipt-privacy">仅保存在本机 · 分享不带逐笔明细</text>
    </view>

    <view class="share-footer">
      <view class="share-card__copy">
        <text class="share-card__title">把今天的从容分享出去</text>
        <text class="share-card__eyebrow">只分享结果，不分享消费明细</text>
      </view>
      <view class="share-actions">
        <button class="share-button share-button--friend" open-type="share">分享给好友</button>
        <button class="share-button" bindtap="handleTimelineGuide">朋友圈 · 右上角</button>
      </view>
    </view>
  </block>

  <view class="legal-note">本结果仅用于日常预算参考，不构成理财建议。</view>
</view>

<view class="drawer-layer" wx:if="{{drawerVisible}}" catchtouchmove="noop">
  <view class="drawer-mask" bindtap="closeDrawer"></view>
  <view class="settings-drawer">
    <view class="drawer-handle"></view>
    <view class="drawer-header">
      <view>
        <text class="drawer-eyebrow">{{drawerMode === 'first' ? '先把本月的边界说清楚' : '调整后立即重新计算'}}</text>
        <text class="drawer-title">{{drawerMode === 'first' ? '设置本月预算' : '修改本月设置'}}</text>
      </view>
      <button
        wx:if="{{drawerMode === 'edit'}}"
        class="drawer-close"
        bindtap="closeDrawer"
        aria-label="关闭设置"
      >关闭</button>
    </view>

    <scroll-view class="drawer-scroll" scroll-y="true">
      <view class="form-field">
        <text class="field-label">本月收入</text>
        <view class="form-input {{formErrors.income ? 'form-input--error' : ''}}">
          <text>¥</text>
          <input type="digit" value="{{form.income}}" data-field="income" bindinput="handleFormInput" placeholder="例如 8000" aria-label="本月收入" />
        </view>
        <text class="field-error" aria-role="alert" wx:if="{{formErrors.income}}">{{formErrors.income}}</text>
      </view>

      <view class="form-field">
        <text class="field-label">本月固定支出</text>
        <view class="form-input {{formErrors.fixedExpense ? 'form-input--error' : ''}}">
          <text>¥</text>
          <input type="digit" value="{{form.fixedExpense}}" data-field="fixedExpense" bindinput="handleFormInput" placeholder="房租、还款、会员等" aria-label="本月固定支出" />
        </view>
        <text class="field-helper">不包含日常吃饭、交通和购物。</text>
        <text class="field-error" aria-role="alert" wx:if="{{formErrors.fixedExpense}}">{{formErrors.fixedExpense}}</text>
      </view>

      <view class="form-field">
        <text class="field-label">本月想存下的钱</text>
        <view class="form-input {{formErrors.savingGoal ? 'form-input--error' : ''}}">
          <text>¥</text>
          <input type="digit" value="{{form.savingGoal}}" data-field="savingGoal" bindinput="handleFormInput" placeholder="例如 1000" aria-label="本月想存下的钱" />
        </view>
        <text class="field-error" aria-role="alert" wx:if="{{formErrors.savingGoal}}">{{formErrors.savingGoal}}</text>
      </view>

      <view class="form-field">
        <text class="field-label">开始使用前，本月已经花掉的日常消费</text>
        <view class="form-input {{formErrors.historicalSpentBeforeTracking ? 'form-input--error' : ''}}">
          <text>¥</text>
          <input type="digit" value="{{form.historicalSpentBeforeTracking}}" data-field="historicalSpentBeforeTracking" bindinput="handleFormInput" placeholder="从本月 1 日到昨天" aria-label="开始使用前已经花掉的日常消费" />
        </view>
        <text class="field-helper">不要重复填写固定支出，也不要包含已经在本小程序中记录的消费。</text>
        <text class="field-error" aria-role="alert" wx:if="{{formErrors.historicalSpentBeforeTracking}}">{{formErrors.historicalSpentBeforeTracking}}</text>
      </view>

      <view class="local-only-note">
        <view class="local-only-note__dot"></view>
        <text>数据只保存在当前设备中，不会上传。</text>
      </view>

      <button
        class="primary-button drawer-save"
        bindtap="saveBudgetForm"
        disabled="{{isBudgetSaving}}"
        loading="{{isBudgetSaving}}"
      >{{isBudgetSaving ? '保存中…' : '保存并查看结果'}}</button>

      <button
        wx:if="{{drawerMode === 'edit'}}"
        class="reset-button"
        bindtap="resetCurrentMonth"
      >重置本月数据</button>
    </scroll-view>
  </view>
</view>
