  align-items: center;
}

.capture-transcript__heading image {
  width: 40rpx;
  height: 40rpx;
}

.capture-transcript__heading text {
  margin-left: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.capture-transcript__heading button {
  min-width: 132rpx;
  min-height: 64rpx;
  margin-left: auto;
  color: #0A84FF !important;
  font-size: 23rpx !important;
}

.capture-transcript__input {
  width: 100%;
  min-height: 96rpx;
  margin-top: 18rpx;
  color: var(--theme-text, #1D1D1F);
  font-size: 28rpx;
  line-height: 44rpx;
}

.capture-sheet__section-heading {
  display: flex;
  flex-direction: column;
  margin: 36rpx 0 18rpx;
}

.capture-sheet__section-heading text:first-child {
