.theme-entry__subtitle {
  margin-top: 4rpx;
  color: var(--theme-muted, #6B7369);
  font-size: 21rpx;
}

.theme-entry__action {
  color: var(--theme-primary, #123F35);
  font-size: 23rpx;
  font-weight: 700;
}

.drawer-save { margin-top: 28rpx; }

.reset-button {
  min-height: 88rpx;
  margin: 18rpx 0 0;
  background: transparent;
  color: #C84F4A;
  font-size: 24rpx;
  line-height: 88rpx;
}

.theme-drawer {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  max-height: 92vh;
  padding: 16rpx 32rpx 0;
  border-radius: 56rpx 56rpx 0 0;
  background: var(--theme-surface, #FFF9EC);
  color: var(--theme-text, #123F35);
  box-shadow: 0 -24rpx 70rpx rgba(22, 35, 29, 0.18);
  animation: drawer-in 220ms ease-out;
}

.theme-drawer__title,
.theme-drawer__subtitle {
  display: block;
}

.theme-drawer__title {
  font-size: 42rpx;
  font-weight: 800;
}

.theme-drawer__subtitle {
  margin-top: 8rpx;
  color: var(--theme-muted, #6B7369);
  font-size: 22rpx;
}

.theme-scroll {
  box-sizing: border-box;
  max-height: calc(92vh - 148rpx);
  margin-top: 22rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.theme-preset-grid {
  display: flex;
  flex-wrap: wrap;
  margin: -8rpx;
}

.theme-preset {
  box-sizing: border-box;
  width: calc(33.333% - 16rpx);
  min-height: 148rpx;
  margin: 8rpx;
  padding: 18rpx 14rpx;
  border: 3rpx solid transparent;
  border-radius: 26rpx;
  background: var(--theme-page, #F5EBD7);
  color: var(--theme-text, #123F35);
  font-size: 21rpx;
  font-weight: 650;
  line-height: 1.3;
  text-align: left;
}

.theme-preset--selected {
  border-color: var(--theme-primary, #123F35);
}

.theme-swatches {
  display: flex;
  margin-bottom: 16rpx;
}

.theme-swatch {
  box-sizing: border-box;
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid rgba(20, 28, 23, 0.12);
  border-radius: 50%;
}

.theme-swatch + .theme-swatch {
  margin-left: 5rpx;
}

.theme-advanced {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: var(--theme-page, #F5EBD7);
}

.theme-advanced__title {
  display: block;
  font-size: 25rpx;
  font-weight: 800;
}

.theme-control {
  margin-top: 18rpx;
}

.theme-control__heading {
  display: flex;
  justify-content: space-between;
  color: var(--theme-muted, #6B7369);
  font-size: 21rpx;
}

.theme-control slider {
  margin: 2rpx 0 0;
}

.theme-safety-note {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: #FFE7A1;
  color: #352E16;
  font-size: 21rpx;
  line-height: 1.5;
}

.theme-actions {
  display: flex;
  margin-top: 20rpx;
}

.theme-action {
  flex: 1;
  box-sizing: border-box;
  min-height: 96rpx;
  margin: 0;
  padding: 0 12rpx;
  border-radius: 26rpx;
  font-size: 25rpx;
  font-weight: 750;
  line-height: 92rpx;
}

.theme-action + .theme-action {
  margin-left: 16rpx;
}

.theme-action--secondary {
  border: 2rpx solid var(--theme-primary, #123F35);
  background: transparent;
  color: var(--theme-primary, #123F35);
}

.theme-action--primary {
  background: var(--theme-primary, #123F35);
  color: var(--theme-on-primary, #FFF9EC);
}

@keyframes fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes drawer-in {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.budget-rail__cycle {
  display: block;
  margin-top: 10rpx;
  color: var(--theme-muted, #6B7369);
  font-size: 21rpx;
}

.weekly-summary {
  margin-top: 22rpx;
  padding: 22rpx;
  border-left: 10rpx solid var(--theme-primary, #123F35);
  background: rgba(255, 255, 255, 0.58);
}

.weekly-summary__heading,
.weekly-summary__insights { display: flex; flex-direction: column; }
.weekly-summary__title { color: #123F35; font-size: 27rpx; font-weight: 800; }
.weekly-summary__scope,
.weekly-summary__comparison,
.weekly-summary__insights { color: #5E6D65; font-size: 21rpx; }
.weekly-summary__scope { margin-top: 4rpx; }
.weekly-summary__totals { display: grid; grid-template-columns: 1fr 1fr; margin-top: 16rpx; border-top: 2rpx solid rgba(18, 63, 53, 0.18); border-bottom: 2rpx solid rgba(18, 63, 53, 0.18); }
.weekly-summary__totals > view { padding: 14rpx 0; display: flex; flex-direction: column; }
.weekly-summary__totals > view + view { padding-left: 18rpx; border-left: 2rpx solid rgba(18, 63, 53, 0.18); }
.weekly-summary__totals text:first-child { color: #66776E; font-size: 19rpx; }
.weekly-summary__totals text:last-child { margin-top: 4rpx; color: #123F35; font-size: 29rpx; font-weight: 800; }
.weekly-summary__comparison { display: block; margin-top: 14rpx; color: var(--theme-primary, #123F35); font-weight: 700; }
.weekly-summary__insights { margin-top: 10rpx; }

.quick-templates { margin: 22rpx 0; border-top: 2rpx solid rgba(18, 63, 53, 0.2); }
.quick-templates__heading { padding: 16rpx 0 8rpx; display: flex; flex-direction: column; }
.quick-templates__heading text:first-child { color: #123F35; font-size: 23rpx; font-weight: 800; }
.quick-templates__heading text:last-child { margin-top: 3rpx; color: #596A61; font-size: 19rpx; }
.quick-template { display: flex; align-items: stretch; margin-top: 10rpx; border: 2rpx solid #123F35; background: rgba(255, 255, 255, 0.52); }
.quick-template__use { min-height: 92rpx; flex: 1; padding: 12rpx 16rpx; display: flex; align-items: center; justify-content: space-between; text-align: left; background: transparent; border-radius: 0; }
.quick-template__use > view { display: flex; flex-direction: column; }
.quick-template__title { color: #123F35; font-size: 24rpx; font-weight: 800; }
.quick-template__meta { margin-top: 3rpx; color: #596A61; font-size: 18rpx; }
.quick-template__amount { margin-left: 12rpx; color: var(--theme-primary, #123F35); font-size: 26rpx; font-weight: 800; }
.quick-template__delete { width: 104rpx; min-height: 92rpx; border-left: 2rpx solid #123F35; border-radius: 0; color: #B73B30; font-size: 20rpx; background: transparent; }
.template-save-button { min-height: 88rpx; margin-top: 14rpx; border: 2rpx dashed var(--theme-primary, #123F35); border-radius: 0; color: var(--theme-primary, #123F35); font-size: 22rpx; font-weight: 700; background: transparent; }

.selector-field { min-height: 92rpx; padding: 0 22rpx; display: flex; align-items: center; border: 2rpx solid #D7E3DB; border-radius: 24rpx; color: #16231D; font-size: 27rpx; font-weight: 700; background: #F9FBF9; }
.budget-detail-section { margin: 8rpx 0 30rpx; padding: 20rpx; border: 2rpx dashed rgba(18, 63, 53, 0.4); background: rgba(255, 255, 255, 0.42); }
.budget-detail-section__heading { display: flex; align-items: flex-start; justify-content: space-between; }
.budget-detail-section__heading > view { min-width: 0; flex: 1; display: flex; flex-direction: column; }
.budget-detail-section__title { color: #123F35; font-size: 24rpx; font-weight: 800; }
.fixed-expense-add { box-sizing: border-box; width: 100%; min-height: 88rpx; margin: 18rpx 0 0; padding: 0 20rpx 0 24rpx; display: flex; align-items: center; justify-content: space-between; border: 2rpx solid rgba(18, 63, 53, 0.42); border-radius: 18rpx; color: var(--theme-primary, #123F35); font-size: 22rpx; font-weight: 750; text-align: left; background: var(--theme-page, #F5EBD7); }
.fixed-expense-add__mark { width: 48rpx; height: 48rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: var(--theme-on-primary, #FFF9EC); font-size: 30rpx; line-height: 48rpx; text-align: center; background: var(--theme-primary, #123F35); }
.fixed-expense-add:active { opacity: 0.76; }
.fixed-expense-row { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr) 112rpx; margin-top: 12rpx; overflow: hidden; border: 2rpx solid rgba(18, 63, 53, 0.5); border-radius: 18rpx; background: rgba(255, 255, 255, 0.68); }
.fixed-expense-row__name,
.fixed-expense-row__amount,
.fixed-expense-row__delete { min-height: 88rpx; }
.fixed-expense-row__name { padding: 0 12rpx; }
.fixed-expense-row__amount { display: flex; align-items: center; padding: 0 10rpx; border-left: 2rpx solid rgba(18, 63, 53, 0.22); }
.fixed-expense-row__amount input { min-width: 0; flex: 1; }
.fixed-expense-row__delete { box-sizing: border-box; width: 112rpx; margin: 0; padding: 0; border: 0; border-left: 2rpx solid rgba(183, 59, 48, 0.24); border-radius: 0; color: #A63830; font-size: 20rpx; font-weight: 750; line-height: 88rpx; white-space: nowrap; background: #FFF0EC; transition: background-color 180ms ease, opacity 180ms ease; }
.fixed-expense-row__delete::after { border: 0; }
.fixed-expense-row__delete:active { opacity: 0.78; background: #F6D5CD; }
@media (max-width: 340px) {
  .page-shell {
    padding-right: 24rpx;
    padding-left: 24rpx;
  }

  .hero-content {
    padding-right: 30rpx;
    padding-left: 30rpx;
  }

  .composer-save {
    width: 190rpx;
    margin-left: 14rpx;
    font-size: 26rpx;
  }

  .receipt-card {
    padding-right: 26rpx;
    padding-left: 26rpx;
  }

  .record-tag {
    min-width: 92rpx;
  }

  .record-main {
    margin-left: 18rpx;
  }
}

@media (prefers-reduced-motion: reduce) {
  .skeleton,
  .drawer-mask,
  .settings-drawer,
  .theme-drawer,
  .edit-drawer,
  .fold-content {
    animation: none;
  }

  .page-shell,
  .hero-card,
  .hero-copy-paper,
  .hero-badge,
  .budget-rail,
  .budget-rail__spent,
  .review-card,
  .review-bar__fill,
  .record-composer {
    transition: none;
  }
}
