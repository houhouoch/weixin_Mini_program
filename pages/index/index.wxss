  font-weight: 600;
  line-height: 46rpx;
}

.capture-sheet__section-heading text:last-child {
  margin-top: 4rpx;
  color: var(--theme-muted, #8E8E93);
  font-size: 22rpx;
  line-height: 32rpx;
}

.capture-draft {
  display: flex;
  align-items: flex-start;
  min-height: 190rpx;
  padding: 28rpx;
  transition: opacity 180ms ease-out;
}

.capture-draft + .capture-draft { margin-top: 20rpx; }
.capture-draft--off { opacity: 0.48; }

.capture-draft__check {
  display: flex !important;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 48rpx;
  height: 48rpx;
  border: 2rpx solid var(--theme-border, #D1D1D6) !important;
  border-radius: 24rpx !important;
  color: #FFFFFF !important;
  font-size: 28rpx !important;
}

.capture-draft__check--on {
  border-color: #0A84FF !important;
  background: #0A84FF !important;
}

.capture-draft__body {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  margin-left: 18rpx;
}

.capture-draft__note {
  width: 100%;
  height: 48rpx;
  color: var(--theme-text, #1D1D1F);
  font-size: 31rpx;
  font-weight: 600;
  line-height: 44rpx;
}

.capture-draft__meta {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx 18rpx;
  margin-top: 10rpx;
  color: var(--theme-muted, #6E6E73);
  font-size: 22rpx;
  line-height: 34rpx;
}

.capture-draft__conversion {
  margin-top: 12rpx;
  color: var(--theme-muted, #8E8E93);
  font-size: 20rpx;
  line-height: 30rpx;
}

.capture-draft__amount {
  display: flex;
  align-items: center;
  flex: none;
  width: 150rpx;
  margin-left: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.capture-draft__amount input {
  width: 124rpx;
  height: 52rpx;
  color: var(--theme-text, #1D1D1F);
  font-size: 30rpx;
  font-weight: 600;
  text-align: right;
}

.capture-note {
  margin-top: 22rpx;
  padding: 24rpx 28rpx;
  border-radius: 24rpx;
  background: var(--theme-control, #EDEDF2);
  color: var(--theme-muted, #6E6E73);
  font-size: 22rpx;
  line-height: 34rpx;
}

.capture-error {
  display: block;
  margin-top: 18rpx;
  color: #C9342F;
  font-size: 23rpx;
  line-height: 34rpx;
}

.capture-sheet__bottom-space { height: 40rpx; }

.capture-actions {
  display: flex;
  flex: none;
  gap: 18rpx;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--theme-hairline, rgba(60, 60, 67, 0.12));
  background: var(--theme-surface, #FFFFFF);
}

.capture-actions button {
  display: flex !important;
  align-items: center;
  justify-content: center;
  min-height: 100rpx;
  border-radius: 28rpx !important;
  font-size: 28rpx !important;
  font-weight: 600 !important;
}

.capture-actions__secondary {
  flex: 0 0 220rpx;
  background: var(--theme-control, #F2F2F7) !important;
}

.capture-actions__primary {
  flex: 1;
  background: #0A84FF !important;
  color: #FFFFFF !important;
}

.photo-review__image {
  width: 100%;
  height: 420rpx;
  border-radius: 32rpx;
  background: #E5E5EA;
}

.photo-review__notice,
.photo-review__form {
  margin-top: 20rpx;
  padding: 28rpx;
}

.photo-review__notice {
  display: flex;
  flex-direction: column;
}

.photo-review__notice text:first-child {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 40rpx;
}

.photo-review__notice text:last-child {
  margin-top: 8rpx;
  color: var(--theme-muted, #6E6E73);
  font-size: 22rpx;
  line-height: 36rpx;
}

.photo-review__form label {
  display: flex;
  flex-direction: column;
}

.photo-review__form label + label {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--theme-hairline, rgba(60, 60, 67, 0.12));
}

.photo-review__form label > text {
  color: var(--theme-muted, #6E6E73);
  font-size: 22rpx;
}

.photo-review__form label > input,
.photo-review__amount {
  height: 68rpx;
  margin-top: 6rpx;
  color: var(--theme-text, #1D1D1F);
  font-size: 32rpx;
  font-weight: 500;
}

.photo-review__amount {
  display: flex;
  align-items: center;
}

.photo-review__amount input {
  flex: 1;
  height: 68rpx;
  margin-left: 8rpx;
  font-size: 36rpx;
  font-weight: 600;
}

.photo-review__row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--theme-hairline, rgba(60, 60, 67, 0.12));
  color: #0A84FF;
  font-size: 23rpx;
  line-height: 40rpx;
}

.default-budget-entry {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 24rpx;
  padding: 24rpx;
  border: 1rpx solid var(--theme-hairline, rgba(60, 60, 67, 0.12));
  border-radius: 28rpx;
  background: var(--theme-surface, #FFFFFF);
  text-align: center;
}

.default-budget-entry > text:first-child {
  color: var(--theme-text, #1D1D1F);
  font-size: 24rpx;
  font-weight: 500;
  line-height: 34rpx;
}

.default-budget-entry button {
  width: 100%;
  min-height: 92rpx;
  margin-top: 14rpx;
  border-radius: 24rpx;
  background: var(--theme-control, #F2F2F7);
  color: #0A84FF;
  font-size: 27rpx;
  font-weight: 600;
}

.default-budget-entry > text:last-child {
  margin-top: 12rpx;
  color: var(--theme-muted, #8E8E93);
  font-size: 20rpx;
  line-height: 32rpx;
}

@media (max-width: 340px) {
  .minimal-entry__actions { gap: 6rpx; margin-left: 12rpx; }
  .minimal-entry__tool { width: 64rpx; height: 64rpx; }
  .minimal-entry__voice { width: 72rpx; height: 72rpx; }
  .minimal-analysis__metrics { grid-template-columns: 1fr; }
  .minimal-analysis__metrics > view { padding: 16rpx 0; }
  .minimal-analysis__metrics > view + view { border-top: 1rpx solid var(--theme-hairline, rgba(60, 60, 67, 0.12)); border-left: 0; }
  .capture-draft { flex-wrap: wrap; }
  .capture-draft__amount { width: 100%; margin: 18rpx 0 0 66rpx; }
  .capture-draft__amount input { flex: 1; text-align: left; }
}

@media (prefers-reduced-motion: reduce) {
  .capture-sheet { animation: none; }
  .capture-draft { transition: none; }
}
