.page-shell {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 24rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
  background: var(--theme-page, #F5EBD7);
  color: var(--theme-text, #123F35);
  transition: background-color 220ms ease, color 220ms ease;
}

.share-entry {
  display: flex;
  flex-direction: column;
  margin-bottom: 24rpx;
  padding: 28rpx 30rpx;
  border: 2rpx solid #E96950;
  background: #FFF9EC;
}

.share-entry__eyebrow,
.drawer-eyebrow {
  color: #E65A3F;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.share-entry__title {
  margin-top: 8rpx;
  color: #123F35;
  font-size: 34rpx;
  font-weight: 700;
}

.share-entry__copy {
  margin-top: 8rpx;
  color: #6C756D;
  font-size: 24rpx;
}

.page-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 116rpx;
  margin-bottom: 20rpx;
  padding: 0 4rpx;
}

.page-topbar__copy,
.drawer-header > view:first-child,
.receipt-header__copy,
.share-card__copy {
  display: flex;
  flex-direction: column;
}

.page-title {
  color: var(--theme-text, #123F35);
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.25;
}

.date-label {
  margin-top: 4rpx;
  color: var(--theme-muted, #6C756D);
  font-size: 24rpx;
}

.settings-button,
.drawer-close {
  box-sizing: border-box;
  min-width: 112rpx;
  min-height: 88rpx;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 44rpx;
  background: var(--theme-primary, #123F35);
  color: var(--theme-on-primary, #FFF9EC);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 88rpx;
}

.settings-button:active,
.drawer-close:active,
.section-toggle:active,
.share-button:active,
.edit-record-button:active,
.delete-button:active,
.category-chip:active,
.review-tab:active,
.theme-entry:active,
.theme-preset:active,
.theme-action:active {
  opacity: 0.76;
}

.collapsible-section {
  transition: background-color 220ms ease, border-color 220ms ease, color 220ms ease;
}

.collapsible-section--collapsed {
  padding-top: 20rpx;
  padding-bottom: 20rpx;
}

.section-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
  margin: 0;
  padding: 0;
  background: transparent;
  color: inherit;
  line-height: 1.3;
  text-align: left;
}

.section-toggle__copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.section-toggle__summary {
  margin-top: 5rpx;
  color: var(--theme-muted, #6B7369);
  font-size: 21rpx;
  font-weight: 500;
}

.section-toggle__action {
  flex: none;
  min-width: 88rpx;
  margin-left: 20rpx;
  color: var(--theme-primary, #123F35);
  font-size: 23rpx;
  font-weight: 750;
  text-align: right;
}

.fold-content {
  animation: fold-in 180ms ease-out;
}

@keyframes fold-in {
  from { opacity: 0; transform: translateY(-8rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.hero-card {
  position: relative;
  box-sizing: border-box;
  height: 540rpx;
  overflow: hidden;
  border-radius: 56rpx;
  background: var(--theme-surface, #FFF0CD);
  transition: background-color 220ms ease;
}

.hero-art {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.hero-copy-paper {
  position: absolute;
  z-index: 1;
  top: 28rpx;
  left: 24rpx;
  box-sizing: border-box;
  width: 404rpx;
  height: 328rpx;
  border: 2rpx solid rgba(232, 209, 163, 0.55);
  border-radius: 36rpx;
  background: var(--theme-surface, #FFF9EC);
  transition: background-color 220ms ease, border-color 220ms ease, width 220ms ease;
}

.hero-content {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  box-sizing: border-box;
  height: 100%;
  padding: 42rpx 40rpx;
  color: var(--theme-text, #123F35);
}

.hero-eyebrow {
  font-size: 26rpx;
  font-weight: 750;
}

.hero-amount {
  display: flex;
  align-items: flex-start;
  margin-top: 14rpx;
  font-weight: 850;
  letter-spacing: -4rpx;
  line-height: 1;
  white-space: nowrap;
}

.amount-normal { font-size: 88rpx; }
.amount-medium { font-size: 76rpx; }
.amount-small { font-size: 64rpx; }

.hero-status {
  display: flex;
  flex-direction: column;
  width: 290rpx;
  margin-top: 26rpx;
  color: var(--theme-muted, #3E554C);
  font-size: 25rpx;
  line-height: 1.55;
}

.hero-badge {
  margin-top: auto;
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  background: #F4B942;
  color: #123F35;
  font-size: 23rpx;
  font-weight: 750;
  transition: background-color 220ms ease, color 220ms ease;
}

.hero-card--runningLow .hero-copy-paper {
  border-color: #D69A24;
  background: #FFF4D5;
}

.hero-card--runningLow .hero-content,
.hero-card--todayOverspent .hero-content,
.hero-card--monthOverspent .hero-content,
.hero-card--budgetUnavailable .hero-content {
  color: #173D33;
}

.hero-card--runningLow .hero-status,
.hero-card--todayOverspent .hero-status,
.hero-card--monthOverspent .hero-status,
.hero-card--budgetUnavailable .hero-status {
  color: #3E554C;
}

.hero-card--todayOverspent .hero-copy-paper,
.hero-card--monthOverspent .hero-copy-paper,
.hero-card--budgetUnavailable .hero-copy-paper {
  width: 448rpx;
  border-color: #D13D2E;
  background: #FFE3D6;
}

.hero-card--monthOverspent .hero-copy-paper,
.hero-card--budgetUnavailable .hero-copy-paper {
  border-color: #8E2730;
  background: #F7D5D5;
}

.hero-card--runningLow .hero-badge {
  background: #D69A24;
}

.hero-card--todayOverspent .hero-badge {
  background: #D13D2E;
  color: #FFF7EB;
}

.hero-card--monthOverspent .hero-badge,
.hero-card--budgetUnavailable .hero-badge {
  background: #8E2730;
  color: #FFF7EB;
}

.budget-rail {
  box-sizing: border-box;
  min-height: 172rpx;
  margin-top: 32rpx;
  padding: 28rpx 32rpx;
  border-radius: 36rpx;
  background: var(--theme-primary, #123F35);
  color: var(--theme-on-primary, #FFF9EC);
  transition: background-color 220ms ease, color 220ms ease;
}

.budget-rail__labels {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 23rpx;
}

.budget-rail__labels text:first-child {
  font-size: 26rpx;
  font-weight: 700;
}

.budget-rail__track {
  height: 24rpx;
  margin-top: 20rpx;
  overflow: hidden;
  border-radius: 12rpx;
  background: var(--theme-border, #526C62);
}

.budget-rail__spent {
  min-width: 0;
  height: 100%;
  border-radius: 12rpx;
  background: #F4B942;
  transition: width 220ms ease;
}

.budget-rail--todayOverspent .budget-rail__spent,
.budget-rail--monthOverspent .budget-rail__spent,
.budget-rail--budgetUnavailable .budget-rail__spent {
  background: #E96950;
}

.budget-rail--runningLow {
  background: #6B4A16;
  color: #FFF9EC;
}

.budget-rail--runningLow .budget-rail__spent {
  background: #F4B942;
}

.budget-rail--todayOverspent {
  background: #591A1C;
  color: #FFF9EC;
}

.budget-rail--monthOverspent,
.budget-rail--budgetUnavailable {
  background: #3A1015;
  color: #FFF9EC;
}

.budget-rail__helper {
  display: block;
  margin-top: 14rpx;
  color: var(--theme-on-primary, #D8E2D7);
  opacity: 0.78;
  font-size: 20rpx;
  line-height: 1.4;
}

.review-card {
  box-sizing: border-box;
  margin-top: 32rpx;
  padding: 32rpx;
  border: 2rpx solid var(--theme-border, #E5D9BF);
  border-radius: 36rpx;
  background: var(--theme-surface, #FFF9EC);
  color: var(--theme-text, #123F35);
  transition: background-color 220ms ease, border-color 220ms ease, color 220ms ease;
}

.review-title,
.review-subtitle,
.review-insight,
.review-scope {
  display: block;
}

.review-breakdown {
  margin-top: 22rpx;
  padding: 22rpx;
  border: 2rpx solid var(--theme-border, #E5D9BF);
  border-radius: 22rpx;
  background: var(--theme-page, #F5EBD4);
}

.review-breakdown__header,
.review-category,
.review-detail__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.review-breakdown__title,
.review-detail__title {
  color: var(--theme-text, #123F35);
  font-size: 24rpx;
  font-weight: 800;
}

.review-breakdown__hint {
  color: var(--theme-muted, #6B7369);
  font-size: 18rpx;
}

.review-category {
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
  margin: 12rpx 0 0;
  padding: 12rpx 16rpx;
  border: 0;
  border-radius: 16rpx;
  background: var(--theme-surface, #FFF9EC);
  color: var(--theme-text, #123F35);
  text-align: left;
}

.review-category__copy {
  display: flex;
  flex-direction: column;
}

.review-category__name,
.review-category__amount {
  font-size: 23rpx;
  font-weight: 750;
}

.review-category__meta {
  margin-top: 3rpx;
  color: var(--theme-muted, #6B7369);
  font-size: 18rpx;
}

.review-detail-toggle {
  width: 100%;
  min-height: 88rpx;
  margin: 18rpx 0 0;
  border: 2rpx solid var(--theme-primary, #123F35);
  border-radius: 20rpx;
  background: transparent;
  color: var(--theme-primary, #123F35);
  font-size: 22rpx;
  font-weight: 750;
}

.review-detail-toggle[disabled] {
  opacity: 0.5;
}

.review-detail {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 2rpx dashed var(--theme-border, #E5D9BF);
}

.review-detail__all {
  min-height: 64rpx;
  margin: 0;
  padding: 0 18rpx;
  border: 0;
  border-radius: 16rpx;
  background: var(--theme-page, #F5EBD4);
  color: var(--theme-primary, #123F35);
  font-size: 19rpx;
  line-height: 64rpx;
}

.review-record-list {
  margin-top: 14rpx;
}

.review-title {
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.3;
}

.review-subtitle {
  margin-top: 8rpx;
  color: var(--theme-muted, #6B7369);
  font-size: 22rpx;
  line-height: 1.5;
}

.review-card .section-toggle__action {
  color: var(--theme-primary, #123F35);
}

.review-tabs {
  display: flex;
  margin-top: 20rpx;
  padding: 8rpx;
  border-radius: 24rpx;
  background: var(--theme-page, #F0E5CC);
}

.review-tab {
  flex: 1;
  box-sizing: border-box;
  min-height: 88rpx;
  margin: 0;
  padding: 0;
  border-radius: 18rpx;
  background: transparent;
  color: var(--theme-text, #123F35);
  font-size: 24rpx;
  font-weight: 750;
  line-height: 88rpx;
}

.review-tab--active {
  background: var(--theme-primary, #123F35);
  color: var(--theme-on-primary, #FFF9EC);
}

.review-range {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
}

.review-range__picker {
  flex: 1;
  min-width: 0;
}

.review-range__field {
  box-sizing: border-box;
  min-height: 100rpx;
  padding: 16rpx 18rpx;
  border: 2rpx solid var(--theme-border, #E5D9BF);
  border-radius: 20rpx;
  background: var(--theme-page, #F5EBD4);
}

.review-range__label,
.review-range__value {
  display: block;
}

.review-range__label {
  color: var(--theme-muted, #6B7369);
  font-size: 19rpx;
}

.review-range__value {
  margin-top: 4rpx;
  overflow: hidden;
  color: var(--theme-text, #123F35);
  font-size: 24rpx;
  font-weight: 750;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.review-range__separator {
  flex: 0 0 44rpx;
  color: var(--theme-muted, #6B7369);
  font-size: 20rpx;
  text-align: center;
}

.review-loading,
.review-error {
  box-sizing: border-box;
  min-height: 220rpx;
  margin-top: 20rpx;
  padding: 80rpx 24rpx;
  color: var(--theme-muted, #6B7369);
  font-size: 23rpx;
  text-align: center;
}

.review-error {
  color: #B73B30;
}

.review-metrics {
  display: flex;
  margin-top: 20rpx;
}

.review-metric {
  display: flex;
  flex: 1;
  flex-direction: column;
  box-sizing: border-box;
  min-width: 0;
  min-height: 112rpx;
  padding: 16rpx 18rpx;
  border-radius: 20rpx;
  background: var(--theme-page, #F5EBD4);
}

.review-metric + .review-metric {
  margin-left: 12rpx;
}

.review-metric__label {
  overflow: hidden;
  color: var(--theme-muted, #6B7369);
  font-size: 20rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.review-metric__value {
  margin-top: 4rpx;
  overflow: hidden;
  color: var(--theme-text, #123F35);
  font-size: 31rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.review-chart {
  display: flex;
  align-items: flex-end;
  box-sizing: border-box;
  height: 220rpx;
  margin-top: 20rpx;
  padding: 10rpx 2rpx 0;
}

.review-bar {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  min-width: 0;
  height: 100%;
}

.review-bar__track {
  position: relative;
  flex: 1;
  width: 72%;
}

.review-bar__fill {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  min-height: 0;
  border-radius: 12rpx 12rpx 4rpx 4rpx;
  background: #F4B942;
  transition: height 220ms ease;
}

.review-bar__fill--today {
  background: var(--theme-primary, #123F35);
}

.review-bar__label {
  margin-top: 10rpx;
  overflow: hidden;
  color: var(--theme-muted, #6B7369);
  font-size: 18rpx;
  text-overflow: clip;
  white-space: nowrap;
}

.review-insight {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: #FFE7A1;
  color: #123F35;
  font-size: 22rpx;
  font-weight: 650;
}

.review-scope {
  margin-top: 14rpx;
  color: var(--theme-muted, #6B7369);
  font-size: 20rpx;
  line-height: 1.5;
}

.record-composer {
  box-sizing: border-box;
  margin-top: 32rpx;
  padding: 36rpx;
  border-radius: 48rpx;
  background: var(--theme-accent, #F4B942);
  color: var(--theme-on-accent, #123F35);
  transition: background-color 220ms ease, color 220ms ease;
}

.record-composer .section-toggle__summary,
.record-composer .section-toggle__action {
  color: var(--theme-on-accent, #123F35);
  opacity: 0.76;
}

.composer-title {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.3;
}

.composer-copy {
  display: block;
  margin-top: 8rpx;
  color: #4E5A50;
  font-size: 22rpx;
  line-height: 1.5;
}

.direction-switch {
  display: flex;
  box-sizing: border-box;
  width: 100%;
  min-height: 96rpx;
  margin-top: 18rpx;
  padding: 8rpx;
  border: 2rpx solid rgba(18, 63, 53, 0.22);
  border-radius: 28rpx;
  background: rgba(255, 249, 236, 0.72);
}

.direction-switch__button {
  flex: 1;
  min-height: 80rpx;
  margin: 0;
  padding: 0 20rpx;
  border-radius: 22rpx;
  background: transparent;
  color: #31574D;
  font-size: 26rpx;
  font-weight: 750;
  line-height: 80rpx;
}

.direction-switch__button--active {
  background: var(--theme-primary, #123F35);
  color: var(--theme-on-primary, #FFF9EC);
}

.direction-switch__button[disabled] {
  opacity: 0.48;
}

.direction-switch--edit {
  margin: 0 0 24rpx;
  background: var(--theme-page, #F5EBD7);
}

.category-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 18rpx -7rpx 0;
}

.category-chip {
  box-sizing: border-box;
  width: calc(25% - 14rpx);
  min-height: 88rpx;
  margin: 7rpx;
  padding: 0;
  border-radius: 40rpx;
  background: #FFF9EC;
  color: #123F35;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.category-chip--selected {
  background: var(--theme-primary, #123F35);
  color: var(--theme-on-primary, #FFF9EC);
}

.composer-label {
  display: block;
  margin-top: 18rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.purpose-field,
.composer-amount {
  box-sizing: border-box;
  height: 100rpx;
  border: 2rpx solid transparent;
  border-radius: 28rpx;
  background: #FFF9EC;
}

.purpose-field {
  width: 100%;
  margin-top: 12rpx;
  padding: 0 30rpx;
  color: #123F35;
  font-size: 28rpx;
}

.composer-action-row {
  display: flex;
  margin-top: 16rpx;
}

.composer-amount {
  display: flex;
  flex: 1;
  align-items: center;
  min-width: 0;
  padding: 0 28rpx;
}

.composer-amount > text {
  flex: none;
  margin-right: 12rpx;
  color: #7A8078;
  font-size: 42rpx;
  font-weight: 800;
}

.composer-amount__input {
  flex: 1;
  min-width: 0;
  height: 96rpx;
  color: #123F35;
  font-size: 42rpx;
  font-weight: 800;
}

.composer-field--error {
  border-color: #B73B30;
  background: #FFF4EE;
}

.composer-save {
  box-sizing: border-box;
  width: 222rpx;
  min-height: 100rpx;
  margin: 0 0 0 20rpx;
  padding: 0 16rpx;
  border-radius: 28rpx;
  background: var(--theme-primary, #123F35);
  color: var(--theme-on-primary, #FFF9EC);
  font-size: 29rpx;
  font-weight: 750;
  line-height: 100rpx;
}

.composer-save[disabled] {
  background: #527066;
  color: rgba(255, 249, 236, 0.8);
}

.composer-feedback {
  margin-top: 14rpx;
}

.receipt-card {
  box-sizing: border-box;
  margin-top: 32rpx;
  padding: 32rpx 36rpx 24rpx;
  border: 3rpx dashed var(--theme-primary, #123F35);
  background: var(--theme-surface, #FFF9EC);
}

.section-toggle--receipt .section-toggle__action {
  color: var(--theme-primary, #123F35);
}

.receipt-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.receipt-eyebrow {
  color: #E65A3F;
  font-size: 19rpx;
  font-weight: 750;
}

.receipt-title {
  margin-top: 8rpx;
  color: var(--theme-text, #123F35);
  font-size: 40rpx;
  font-weight: 800;
}

.receipt-count {
  padding-bottom: 5rpx;
  color: var(--theme-text, #123F35);
  font-size: 23rpx;
  font-weight: 700;
}

.receipt-perforation {
  height: 2rpx;
  margin-top: 22rpx;
  background-image: repeating-linear-gradient(to right, #D9CDAE 0, #D9CDAE 8rpx, transparent 8rpx, transparent 16rpx);
}

.history-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 112rpx;
  padding: 18rpx 0;
}

.history-toolbar__copy {
  display: flex;
  flex-direction: column;
}

.history-toolbar__label {
  color: var(--theme-text, #123F35);
  font-size: 25rpx;
  font-weight: 750;
}

.history-toolbar__summary {
  margin-top: 5rpx;
  color: var(--theme-muted, #7C837A);
  font-size: 21rpx;
}

.budget-rail__income {
  display: block;
  margin-top: 8rpx;
  color: var(--theme-primary, #123F35);
  font-size: 21rpx;
  font-weight: 700;
}

.history-date-button {
  box-sizing: border-box;
  min-height: 88rpx;
  padding: 0 22rpx;
  border-radius: 22rpx;
  background: var(--theme-primary, #123F35);
  color: var(--theme-on-primary, #FFF9EC);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 88rpx;
}

.history-loading,
.history-error {
  min-height: 180rpx;
  padding: 68rpx 20rpx;
