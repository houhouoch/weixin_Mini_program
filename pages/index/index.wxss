.capture-sheet {
  position: fixed;
  z-index: 60;
  inset: 0;
  display: flex;
  flex-direction: column;
  background: var(--theme-page, #F5F5F7);
  color: var(--theme-text, #1D1D1F);
  animation: capture-sheet-in 200ms cubic-bezier(0.22, 1, 0.36, 1);
}

@keyframes capture-sheet-in {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.capture-sheet__header {
  display: flex;
  align-items: flex-start;
  flex: none;
  padding: calc(28rpx + env(safe-area-inset-top)) 32rpx 24rpx;
}

.capture-sheet__header > view {
