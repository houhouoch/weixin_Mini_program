  align-items: center;
  justify-content: center;
  flex: none;
  width: 72rpx;
  height: 72rpx;
  color: var(--theme-text, #1D1D1F) !important;
  font-family: Arial, sans-serif !important;
  font-size: 64rpx !important;
  font-weight: 300 !important;
  line-height: 64rpx !important;
}

.capture-sheet__title {
  font-size: 44rpx;
  font-weight: 600;
  letter-spacing: -0.8rpx;
  line-height: 56rpx;
}

.capture-sheet__subtitle {
  margin-top: 4rpx;
  color: var(--theme-muted, #6E6E73);
  font-size: 23rpx;
  line-height: 34rpx;
}

.capture-sheet__scroll {
  flex: 1;
  min-height: 0;
  padding: 8rpx 32rpx 0;
}

.capture-transcript,
.capture-draft,
.photo-review__notice,
.photo-review__form {
  border-radius: 32rpx;
  background: var(--theme-surface, #FFFFFF);
