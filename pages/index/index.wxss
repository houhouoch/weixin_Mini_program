}

.theme-entry__action {
  color: var(--theme-primary, #123F35);
  font-size: 23rpx;
  font-weight: 700;
}

.drawer-save { margin-top: 28rpx; }

.reset-button {
  min-height: 88rpx;
  margin: 18rpx 0 0;
  background: transparent;
  color: #C84F4A;
  font-size: 24rpx;
  line-height: 88rpx;
}

.theme-drawer {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  max-height: 86vh;
  padding: 16rpx 40rpx 0;
  border-radius: 48rpx 48rpx 0 0;
  background: var(--theme-surface, #FFFFFF);
  color: var(--theme-text, #1D1D1F);
  box-shadow: 0 -20rpx 64rpx rgba(0, 0, 0, 0.16);
  animation: drawer-in 220ms ease-out;
}

.theme-drawer__title,
.theme-drawer__subtitle {
  display: block;
}

.theme-drawer__title {
  font-size: 44rpx;
  font-weight: 600;
  letter-spacing: -0.6rpx;
  line-height: 56rpx;
}

.theme-drawer__subtitle {
  margin-top: 6rpx;
  color: var(--theme-muted, #6E6E73);
  font-size: 23rpx;
  line-height: 34rpx;
}

.theme-scroll {
  box-sizing: border-box;
  max-height: calc(86vh - 148rpx);
  margin-top: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.theme-preset-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}

.theme-preset {
  position: relative;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  min-height: 276rpx;
  margin: 0;
  padding: 16rpx;
  border: 3rpx solid var(--theme-border, #D2D2D7);
  border-radius: 30rpx;
  background: var(--theme-surface, #FFFFFF);
  color: var(--theme-text, #1D1D1F);
  text-align: left;
}

.theme-preset--selected {
  border-color: var(--theme-primary, #0066CC);
  box-shadow: 0 0 0 5rpx rgba(10, 132, 255, 0.1);
}

.theme-preview {
  width: 100%;
  height: 142rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(128, 128, 128, 0.22);
  border-radius: 20rpx;
}

.theme-preview__bar {
  width: 52%;
  height: 8rpx;
  border-radius: 4rpx;
  opacity: 0.9;
}

.theme-preview__surface {
  position: relative;
  height: 76rpx;
  margin-top: 14rpx;
  border-radius: 14rpx;
  box-shadow: 0 5rpx 14rpx rgba(0, 0, 0, 0.1);
}

.theme-preview__accent {
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  width: 42rpx;
  height: 18rpx;
  border-radius: 9rpx;
}

.theme-preset__copy {
  display: flex;
  flex-direction: column;
  margin-top: 16rpx;
}

.theme-preset__name {
  font-size: 27rpx;
  font-weight: 600;
  line-height: 38rpx;
}

.theme-preset__description {
  margin-top: 2rpx;
  color: var(--theme-muted, #6E6E73);
  font-size: 20rpx;
  line-height: 30rpx;
}

.theme-preset__check {
  position: absolute;
  top: 28rpx;
  right: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  border-radius: 21rpx;
  background: var(--theme-primary, #0066CC);
  color: var(--theme-on-primary, #FFFFFF);
  font-size: 24rpx;
  font-weight: 600;
}

.theme-safety-note {
  margin-top: 28rpx;
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  background: var(--theme-control, #E8E8ED);
  color: var(--theme-muted, #6E6E73);
  font-size: 21rpx;
  line-height: 1.5;
}

.theme-actions {
  display: flex;
  margin-top: 20rpx;
}

.theme-action {
  flex: 1;
  box-sizing: border-box;
  min-height: 96rpx;
  margin: 0;
  padding: 0 12rpx;
  border-radius: 24rpx;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 92rpx;
}

.theme-action + .theme-action {
  margin-left: 16rpx;
}

.theme-action--secondary {
  background: var(--theme-control, #E8E8ED);
  color: var(--theme-primary, #0066CC);
}

.theme-action--primary {
  background: var(--theme-primary, #0066CC);
  color: var(--theme-on-primary, #FFFFFF);
}

@keyframes fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes drawer-in {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.budget-rail__cycle {
  display: block;
  margin-top: 10rpx;
  color: var(--theme-muted, #6B7369);
  font-size: 21rpx;
}

.weekly-summary {
  margin-top: 22rpx;
  padding: 22rpx;
  border-left: 10rpx solid var(--theme-primary, #123F35);
  background: rgba(255, 255, 255, 0.58);
}

.weekly-summary__heading,
.weekly-summary__insights { display: flex; flex-direction: column; }
.weekly-summary__title { color: #123F35; font-size: 27rpx; font-weight: 800; }
.weekly-summary__scope,
.weekly-summary__comparison,
.weekly-summary__insights { color: #5E6D65; font-size: 21rpx; }
.weekly-summary__scope { margin-top: 4rpx; }
.weekly-summary__totals { display: grid; grid-template-columns: 1fr 1fr; margin-top: 16rpx; border-top: 2rpx solid rgba(18, 63, 53, 0.18); border-bottom: 2rpx solid rgba(18, 63, 53, 0.18); }
.weekly-summary__totals > view { padding: 14rpx 0; display: flex; flex-direction: column; }
.weekly-summary__totals > view + view { padding-left: 18rpx; border-left: 2rpx solid rgba(18, 63, 53, 0.18); }
.weekly-summary__totals text:first-child { color: #66776E; font-size: 19rpx; }
.weekly-summary__totals text:last-child { margin-top: 4rpx; color: #123F35; font-size: 29rpx; font-weight: 800; }
.weekly-summary__comparison { display: block; margin-top: 14rpx; color: var(--theme-primary, #123F35); font-weight: 700; }
.weekly-summary__insights { margin-top: 10rpx; }

.quick-templates { margin: 22rpx 0; border-top: 2rpx solid rgba(18, 63, 53, 0.2); }
.quick-templates__heading { padding: 16rpx 0 8rpx; display: flex; flex-direction: column; }
.quick-templates__heading text:first-child { color: #123F35; font-size: 23rpx; font-weight: 800; }
.quick-templates__heading text:last-child { margin-top: 3rpx; color: #596A61; font-size: 19rpx; }
.quick-template { display: flex; align-items: stretch; margin-top: 10rpx; border: 2rpx solid #123F35; background: rgba(255, 255, 255, 0.52); }
.quick-template__use { min-height: 92rpx; flex: 1; padding: 12rpx 16rpx; display: flex; align-items: center; justify-content: space-between; text-align: left; background: transparent; border-radius: 0; }
.quick-template__use > view { display: flex; flex-direction: column; }
.quick-template__title { color: #123F35; font-size: 24rpx; font-weight: 800; }
.quick-template__meta { margin-top: 3rpx; color: #596A61; font-size: 18rpx; }
.quick-template__amount { margin-left: 12rpx; color: var(--theme-primary, #123F35); font-size: 26rpx; font-weight: 800; }
.quick-template__delete { width: 104rpx; min-height: 92rpx; border-left: 2rpx solid #123F35; border-radius: 0; color: #B73B30; font-size: 20rpx; background: transparent; }
.template-save-button { min-height: 88rpx; margin-top: 14rpx; border: 2rpx dashed var(--theme-primary, #123F35); border-radius: 0; color: var(--theme-primary, #123F35); font-size: 22rpx; font-weight: 700; background: transparent; }

.selector-field { min-height: 92rpx; padding: 0 22rpx; display: flex; align-items: center; border: 2rpx solid #D7E3DB; border-radius: 24rpx; color: #16231D; font-size: 27rpx; font-weight: 700; background: #F9FBF9; }
.budget-detail-section { margin: 8rpx 0 30rpx; padding: 20rpx; border: 2rpx dashed rgba(18, 63, 53, 0.4); background: rgba(255, 255, 255, 0.42); }
.budget-detail-section__heading { display: flex; align-items: flex-start; justify-content: space-between; }
.budget-detail-section__heading > view { min-width: 0; flex: 1; display: flex; flex-direction: column; }
.budget-detail-section__title { color: #123F35; font-size: 24rpx; font-weight: 800; }
.fixed-expense-add { box-sizing: border-box; width: 100%; min-height: 88rpx; margin: 18rpx 0 0; padding: 0 20rpx 0 24rpx; display: flex; align-items: center; justify-content: space-between; border: 2rpx solid rgba(18, 63, 53, 0.42); border-radius: 18rpx; color: var(--theme-primary, #123F35); font-size: 22rpx; font-weight: 750; text-align: left; background: var(--theme-page, #F5EBD7); }
.fixed-expense-add__mark { width: 48rpx; height: 48rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: var(--theme-on-primary, #FFF9EC); font-size: 30rpx; line-height: 48rpx; text-align: center; background: var(--theme-primary, #123F35); }
.fixed-expense-add:active { opacity: 0.76; }
.fixed-expense-row { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr) 112rpx; margin-top: 12rpx; overflow: hidden; border: 2rpx solid rgba(18, 63, 53, 0.5); border-radius: 18rpx; background: rgba(255, 255, 255, 0.68); }
.fixed-expense-row__name,
.fixed-expense-row__amount,
.fixed-expense-row__delete { min-height: 88rpx; }
.fixed-expense-row__name { padding: 0 12rpx; }
.fixed-expense-row__amount { display: flex; align-items: center; padding: 0 10rpx; border-left: 2rpx solid rgba(18, 63, 53, 0.22); }
.fixed-expense-row__amount input { min-width: 0; flex: 1; }
.fixed-expense-row__delete { box-sizing: border-box; width: 112rpx; margin: 0; padding: 0; border: 0; border-left: 2rpx solid rgba(183, 59, 48, 0.24); border-radius: 0; color: #A63830; font-size: 20rpx; font-weight: 750; line-height: 88rpx; white-space: nowrap; background: #FFF0EC; transition: background-color 180ms ease, opacity 180ms ease; }
.fixed-expense-row__delete::after { border: 0; }
.fixed-expense-row__delete:active { opacity: 0.78; background: #F6D5CD; }
@media (max-width: 340px) {
  .page-shell {
    padding-right: 24rpx;
    padding-left: 24rpx;
  }

  .hero-content {
    padding-right: 30rpx;
    padding-left: 30rpx;
  }

  .composer-save {
    width: 190rpx;
    margin-left: 14rpx;
    font-size: 26rpx;
  }

  .receipt-card {
    padding-right: 26rpx;
    padding-left: 26rpx;
  }

  .record-tag {
    min-width: 92rpx;
  }

  .record-main {
    margin-left: 18rpx;
  }
}

@media (prefers-reduced-motion: reduce) {
  .skeleton,
  .drawer-mask,
  .settings-drawer,
  .theme-drawer,
  .edit-drawer,
  .fold-content {
    animation: none;
  }

  .page-shell,
  .hero-card,
  .hero-copy-paper,
  .hero-badge,
  .budget-rail,
  .budget-rail__spent,
  .review-card,
  .review-bar__fill,
  .record-composer {
    transition: none;
  }
}

/* Minimal Apple-light home, based on Figma page "Minimal 3.0 · Apple Light Voice". */
.page-shell {
  padding: 12rpx 40rpx calc(64rpx + env(safe-area-inset-bottom));
  background: var(--theme-page, #F5F5F7);
  color: var(--theme-text, #1D1D1F);
  font-weight: 400;
}

.page-topbar {
  min-height: 96rpx;
  margin-bottom: 0;
  padding: 0;
}

.page-title {
  color: var(--theme-text, #1D1D1F);
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: -0.4rpx;
}

.date-label {
  margin-top: 2rpx;
  color: var(--theme-muted, #6E6E73);
  font-size: 22rpx;
}

.settings-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 72rpx;
  width: 72rpx;
  min-height: 72rpx;
  height: 72rpx;
  padding: 0;
  border: 2rpx solid var(--theme-border, #E5E5E7);
  border-radius: 36rpx;
  background: var(--theme-surface, #FFFFFF);
  line-height: 1;
}

.settings-button__icon {
  width: 36rpx;
  height: 36rpx;
}

.hero-card {
  height: auto;
  margin-top: 54rpx;
  overflow: visible;
  border-radius: 0;
  background: transparent;
}

.hero-eyebrow {
  display: block;
  color: var(--theme-muted, #6E6E73);
  font-size: 24rpx;
  font-weight: 400;
}

.hero-amount {
  margin-top: 12rpx;
  color: var(--theme-text, #1D1D1F);
  font-weight: 500;
  letter-spacing: -5rpx;
  line-height: 1.06;
}

.amount-normal { font-size: 104rpx; }
.amount-medium { font-size: 88rpx; }
.amount-small { font-size: 72rpx; }

.hero-status {
  display: block;
  width: auto;
  margin-top: 16rpx;
  color: var(--theme-muted, #6E6E73) !important;
  font-size: 23rpx;
  line-height: 1.5;
}

.budget-rail,
.budget-rail--runningLow,
.budget-rail--todayOverspent,
.budget-rail--monthOverspent,
.budget-rail--budgetUnavailable {
  min-height: 0;
  margin-top: 54rpx;
  padding: 0 0 34rpx;
  border-bottom: 2rpx solid var(--theme-border, #D2D2D7);
  border-radius: 0;
  background: transparent;
  color: var(--theme-text, #1D1D1F);
}

.budget-rail__labels {
  color: var(--theme-muted, #6E6E73);
  font-size: 21rpx;
}

.budget-rail__labels text:first-child {
  color: var(--theme-text, #1D1D1F);
  font-size: 22rpx;
  font-weight: 500;
}

.budget-rail__track {
  height: 8rpx;
  margin-top: 16rpx;
  border-radius: 4rpx;
  background: var(--theme-border, #E5E5EA);
}

.budget-rail__spent,
.budget-rail--runningLow .budget-rail__spent,
.budget-rail--todayOverspent .budget-rail__spent,
.budget-rail--monthOverspent .budget-rail__spent,
.budget-rail--budgetUnavailable .budget-rail__spent {
  border-radius: 4rpx;
  background: var(--theme-primary, #1D1D1F);
}

.budget-rail--todayOverspent .budget-rail__spent,
.budget-rail--monthOverspent .budget-rail__spent,
.budget-rail--budgetUnavailable .budget-rail__spent {
  background: #D70015;
}

.budget-rail__helper,
.budget-rail__cycle,
.budget-rail__income {
  display: block;
  margin-top: 12rpx;
  color: var(--theme-muted, #6E6E73) !important;
  opacity: 1;
  font-size: 20rpx;
}

.review-card,
.receipt-card {
  margin-top: 24rpx;
  padding: 24rpx 0;
  border: 0;
  border-bottom: 2rpx solid var(--theme-border, #D2D2D7);
  border-radius: 0;
  background: transparent;
  color: var(--theme-text, #1D1D1F);
}

.review-card.collapsible-section--collapsed,
.receipt-card.collapsible-section--collapsed {
  padding: 16rpx 0;
}

.section-toggle__summary,
.section-toggle__action,
.review-card .section-toggle__action,
.receipt-card .section-toggle__action {
  color: var(--theme-muted, #6E6E73);
  font-weight: 400;
}

.review-title,
.receipt-title {
  color: var(--theme-text, #1D1D1F);
  font-size: 28rpx;
  font-weight: 500;
}

.record-composer.smart-composer {
  margin-top: 32rpx;
  padding: 30rpx;
  border: 2rpx solid rgba(0, 0, 0, 0.04);
  border-radius: 32rpx;
  background: var(--theme-surface, #FFFFFF);
  color: var(--theme-text, #1D1D1F);
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.055);
  animation: minimal-rise 320ms cubic-bezier(0.16, 1, 0.3, 1);
}

.smart-composer__heading,
.smart-preview__main,
.smart-preview__actions,
.recent-section__heading,
.recent-row,
.smart-details-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.smart-composer__heading-copy {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.smart-composer .composer-title {
  color: var(--theme-text, #1D1D1F);
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: -0.3rpx;
}

.smart-composer .composer-copy {
  margin-top: 5rpx;
  color: var(--theme-muted, #6E6E73);
  font-size: 20rpx;
}

.smart-composer__local {
  margin-left: 16rpx;
  color: var(--theme-muted, #86868B);
  font-size: 18rpx;
  white-space: nowrap;
}

.smart-entry {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  min-height: 96rpx;
  margin-top: 24rpx;
  padding: 8rpx 8rpx 8rpx 26rpx;
  border: 2rpx solid var(--theme-border, #D2D2D7);
  border-radius: 24rpx;
  background: var(--theme-page, #FBFBFD);
  transition: border-color 180ms ease, background-color 180ms ease;
}

.smart-entry:focus-within {
  border-color: var(--theme-primary, #1D1D1F);
  background: var(--theme-surface, #FFFFFF);
}

.smart-entry__input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  color: var(--theme-text, #1D1D1F);
  font-size: 27rpx;
}

.smart-entry__voice {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  min-width: 80rpx;
  height: 80rpx;
  min-height: 80rpx;
  margin: 0;
  padding: 0;
  border-radius: 40rpx;
  background: var(--theme-primary, #1D1D1F);
}

.smart-entry__voice-icon {
  width: 40rpx;
  height: 40rpx;
}

.smart-examples {
  display: flex;
  flex-wrap: wrap;
  margin: 14rpx -6rpx 0;
}

.smart-example {
  min-height: 64rpx;
  margin: 6rpx;
  padding: 0 20rpx;
  border: 2rpx solid var(--theme-border, #E5E5E7);
  border-radius: 32rpx;
  background: var(--theme-page, #F5F5F7);
  color: var(--theme-muted, #6E6E73);
  font-size: 20rpx;
  font-weight: 400;
  line-height: 64rpx;
}

.smart-entry__parse {
  width: 100%;
  min-height: 80rpx;
  margin: 18rpx 0 0;
  border-radius: 20rpx;
  background: var(--theme-primary, #1D1D1F);
  color: var(--theme-on-primary, #FFFFFF);
  font-size: 23rpx;
  font-weight: 500;
}

.smart-preview {
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 2rpx solid var(--theme-border, #E5E5E7);
  animation: preview-in 240ms cubic-bezier(0.16, 1, 0.3, 1);
}

.smart-preview__status {
  display: flex;
  align-items: center;
  color: #248A3D;
  font-size: 20rpx;
  font-weight: 500;
}

.smart-preview__dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #34C759;
}

.smart-preview__main {
  margin-top: 14rpx;
}

.smart-preview__copy {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.smart-preview__note {
  color: var(--theme-text, #1D1D1F);
  font-size: 30rpx;
  font-weight: 500;
}

.smart-preview__meta {
  margin-top: 6rpx;
  color: var(--theme-muted, #6E6E73);
  font-size: 20rpx;
}

.smart-preview__amount {
  margin-left: 20rpx;
  color: var(--theme-text, #1D1D1F);
  font-size: 36rpx;
  font-weight: 500;
  letter-spacing: -1rpx;
  white-space: nowrap;
}

.smart-preview__actions {
  margin-top: 22rpx;
}

.smart-preview__retry,
.smart-preview__confirm {
  min-height: 80rpx;
  margin: 0;
  border-radius: 20rpx;
  font-size: 23rpx;
  font-weight: 500;
}

.smart-preview__retry {
  width: 160rpx;
  background: var(--theme-page, #F5F5F7);
  color: var(--theme-muted, #6E6E73);
}

.smart-preview__confirm {
  flex: 1;
  margin-left: 14rpx;
  background: var(--theme-primary, #1D1D1F);
  color: var(--theme-on-primary, #FFFFFF);
}

.smart-message {
  display: block;
  margin-top: 14rpx;
  color: var(--theme-muted, #6E6E73);
  font-size: 20rpx;
  line-height: 1.45;
}

.smart-message--error { color: #D70015; }
.smart-message--success { color: #248A3D; }

.smart-details-toggle {
  box-sizing: border-box;
  width: 100%;
  min-height: 80rpx;
  margin: 22rpx 0 0;
  padding: 0;
  border-top: 2rpx solid var(--theme-border, #E5E5E7);
  border-radius: 0;
  background: transparent;
  color: var(--theme-muted, #6E6E73);
  font-size: 21rpx;
  font-weight: 400;
}

.smart-details-toggle__action { color: var(--theme-primary, #1D1D1F); }

.smart-details {
  padding-top: 6rpx;
}

.smart-details .direction-switch {
  border-color: var(--theme-border, #D2D2D7);
  background: var(--theme-page, #F5F5F7);
}

