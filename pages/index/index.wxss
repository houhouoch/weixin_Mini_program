/* Minimal 4.0 paged shell */
.minimal-app {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 32rpx 32rpx calc(164rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
  background: var(--theme-page, #F7F6F2);
  color: var(--theme-text, #1D1D1F);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  transition: background-color 180ms ease-out, color 180ms ease-out;
}

.minimal-app view,
.minimal-app text,
.minimal-app button,
.minimal-app input {
  box-sizing: border-box;
}

.minimal-app button {
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: inherit;
  font: inherit;
  line-height: normal;
}

.minimal-app button::after {
  display: none;
}

.minimal-app button:active {
  opacity: 0.62;
}

.minimal-screen {
  width: 100%;
  animation: minimal-screen-in 180ms cubic-bezier(0.22, 1, 0.36, 1);
}

@keyframes minimal-screen-in {
  from { opacity: 0.4; transform: translateY(8rpx); }
  to { opacity: 1; transform: translateY(0); }
}

