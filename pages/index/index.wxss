.page-shell {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 24rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
}

.share-entry {
  display: flex;
  flex-direction: column;
  margin-bottom: 24rpx;
  padding: 28rpx 30rpx;
  border: 2rpx solid #B9DFCE;
  border-radius: 28rpx;
  background: #DDF4E9;
}

.share-entry__eyebrow,
.page-kicker,
.hero-eyebrow,
.share-card__eyebrow,
.drawer-eyebrow {
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.share-entry__eyebrow { color: #16805F; }
.share-entry__title { margin-top: 8rpx; font-size: 34rpx; font-weight: 700; }
.share-entry__copy { margin-top: 8rpx; color: #52645B; font-size: 24rpx; }

.page-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  margin-bottom: 24rpx;
}

.page-topbar > view:first-child,
.drawer-header > view:first-child,
.section-heading > view:first-child {
  display: flex;
  flex-direction: column;
}

.page-kicker { color: #16805F; }
.date-label { margin-top: 6rpx; color: #52645B; font-size: 28rpx; font-weight: 600; }

.settings-button,
.drawer-close {
  box-sizing: border-box;
  min-width: 88rpx;
  min-height: 88rpx;
  margin: 0;
  padding: 0 24rpx;
  border: 2rpx solid #D4E0D8;
  border-radius: 44rpx;
  background: #FFFFFF;
  color: #126B52;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 84rpx;
}

.settings-button:active,
.drawer-close:active,
.share-button:active,
.delete-button:active { opacity: 0.72; }

.hero-card {
  position: relative;
  box-sizing: border-box;
  min-height: 420rpx;
  padding: 48rpx 40rpx;
  overflow: hidden;
  border-radius: 48rpx;
  background: linear-gradient(145deg, #126B52 0%, #16805F 52%, #20A878 100%);
  box-shadow: 0 24rpx 64rpx rgba(18, 107, 82, 0.22);
  color: #FFFFFF;
}

.hero-card--monthOverspent,
.hero-card--todayOverspent { background: linear-gradient(145deg, #9C3E3A, #C84F4A); }
.hero-card--budgetUnavailable { background: linear-gradient(145deg, #56665E, #708078); }
.hero-card--runningLow { background: linear-gradient(145deg, #8E6417, #D69A24); }

.hero-content { position: relative; z-index: 2; display: flex; flex-direction: column; }
.hero-eyebrow { color: rgba(255, 255, 255, 0.76); }
.hero-amount { display: flex; align-items: flex-start; margin-top: 26rpx; font-weight: 750; letter-spacing: -5rpx; line-height: 1; white-space: nowrap; }
.hero-currency { margin-top: 12rpx; margin-right: 8rpx; font-size: 44rpx; font-weight: 700; letter-spacing: -1rpx; }
.amount-normal { font-size: 112rpx; }
.amount-medium { font-size: 90rpx; }
.amount-small { font-size: 72rpx; }
.hero-status { max-width: 570rpx; margin-top: 34rpx; color: rgba(255, 255, 255, 0.88); font-size: 27rpx; line-height: 1.65; }

.hero-orb { position: absolute; border-radius: 50%; background: rgba(255, 255, 255, 0.09); }
.hero-orb--one { top: -100rpx; right: -60rpx; width: 300rpx; height: 300rpx; }
.hero-orb--two { right: 50rpx; bottom: -150rpx; width: 360rpx; height: 360rpx; }

.metrics-card {
  display: flex;
  align-items: stretch;
  margin-top: 24rpx;
  padding: 28rpx 8rpx;
  border: 2rpx solid #E0E9E3;
  border-radius: 32rpx;
  background: #FFFFFF;
}

.metric-item { flex: 1; display: flex; flex-direction: column; align-items: center; min-width: 0; padding: 0 8rpx; text-align: center; }
.metric-label { color: #66776E; font-size: 23rpx; line-height: 1.35; }
.metric-value { max-width: 100%; margin-top: 12rpx; color: #16231D; font-size: 25rpx; font-weight: 700; word-break: break-all; }
.metric-value--danger { color: #C84F4A; }
.metric-divider { width: 2rpx; background: #E8EFEA; }

.content-card,
.share-card,
.error-card,
.loading-card {
  box-sizing: border-box;
  margin-top: 24rpx;
  padding: 36rpx;
  border: 2rpx solid #E0E9E3;
  border-radius: 32rpx;
  background: #FFFFFF;
}

.section-heading { display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 32rpx; }
.section-heading--compact { margin-bottom: 16rpx; }
.section-title { color: #16231D; font-size: 32rpx; font-weight: 700; }
.section-copy { margin-top: 8rpx; color: #66776E; font-size: 23rpx; line-height: 1.5; }
.section-step,
.record-count { padding: 8rpx 16rpx; border-radius: 999rpx; background: #DDF4E9; color: #126B52; font-size: 22rpx; font-weight: 700; }

.field-label { display: block; margin-bottom: 12rpx; color: #52645B; font-size: 25rpx; font-weight: 650; }
.amount-field,
.form-input {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  min-height: 100rpx;
  padding: 0 28rpx;
  border: 2rpx solid #D7E3DB;
  border-radius: 24rpx;
  background: #F9FBF9;
  transition: border-color 180ms ease, background 180ms ease;
}

.amount-field:focus-within,
.form-input:focus-within { border-color: #20A878; background: #FFFFFF; }
.amount-field--error,
.form-input--error { border-color: #C84F4A; background: #FFF8F7; }
.amount-field__currency,
.form-input > text { margin-right: 14rpx; color: #126B52; font-size: 34rpx; font-weight: 700; }
.amount-field__input,
.form-input input { flex: 1; min-width: 0; height: 96rpx; color: #16231D; font-size: 38rpx; font-weight: 700; }
.form-input input { font-size: 30rpx; font-weight: 600; }
.field-error { display: block; margin-top: 10rpx; color: #C84F4A; font-size: 23rpx; line-height: 1.45; }
.field-success { display: block; margin-top: 10rpx; color: #16805F; font-size: 23rpx; }
.field-helper { display: block; margin-top: 10rpx; color: #66776E; font-size: 22rpx; line-height: 1.55; }

.primary-button,
.secondary-button {
  box-sizing: border-box;
  width: 100%;
  min-height: 96rpx;
  margin: 28rpx 0 0;
  border-radius: 24rpx;
  background: #126B52;
  color: #FFFFFF;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 96rpx;
  transition: opacity 180ms ease, transform 180ms ease;
}

.primary-button:active { opacity: 0.86; transform: scale(0.99); }
.primary-button[disabled] { background: #709A88; color: rgba(255, 255, 255, 0.82); }
.secondary-button { background: #DDF4E9; color: #126B52; }

.empty-records { display: flex; flex-direction: column; align-items: center; padding: 42rpx 20rpx 28rpx; text-align: center; }
.empty-records__mark { width: 56rpx; height: 8rpx; margin-bottom: 24rpx; border-radius: 999rpx; background: #B9DFCE; }
.empty-records__title { font-size: 28rpx; font-weight: 700; }
.empty-records__copy { margin-top: 8rpx; color: #66776E; font-size: 24rpx; }

.record-row { display: flex; align-items: center; min-height: 104rpx; border-top: 2rpx solid #EEF3EF; }
.record-row:first-child { border-top: 0; }
.record-dot { flex: none; width: 16rpx; height: 16rpx; margin-right: 20rpx; border-radius: 50%; background: #20A878; }
.record-main { flex: 1; display: flex; flex-direction: column; min-width: 0; }
.record-time { font-size: 25rpx; font-weight: 650; }
.record-type { margin-top: 4rpx; color: #66776E; font-size: 22rpx; }
.record-amount { flex: none; margin-left: 12rpx; font-size: 27rpx; font-weight: 700; }
.delete-button { flex: none; min-width: 88rpx; min-height: 88rpx; margin: 0 0 0 8rpx; padding: 0; background: transparent; color: #C84F4A; font-size: 23rpx; line-height: 88rpx; }

.share-card { background: #EDF7F1; border-color: #CEE7D8; }
.share-card__copy { display: flex; flex-direction: column; }
.share-card__eyebrow { color: #16805F; }
.share-card__title { margin-top: 10rpx; font-size: 30rpx; font-weight: 700; }
.share-actions { display: flex; margin-top: 28rpx; }
.share-button { flex: 1; min-height: 88rpx; margin: 0; padding: 0 12rpx; border: 2rpx solid #B9DFCE; border-radius: 22rpx; background: #FFFFFF; color: #126B52; font-size: 25rpx; font-weight: 700; line-height: 84rpx; }
.share-button + .share-button { margin-left: 16rpx; }
.share-button--friend { border-color: #126B52; background: #126B52; color: #FFFFFF; }
.privacy-note { display: block; margin-top: 18rpx; color: #6D7F75; font-size: 21rpx; line-height: 1.55; }

.legal-note { padding: 32rpx 0 8rpx; color: #95A199; font-size: 20rpx; text-align: center; }

.loading-card { min-height: 420rpx; padding-top: 64rpx; }
.skeleton { border-radius: 999rpx; background: linear-gradient(90deg, #E8EFEA 20%, #F5F8F6 50%, #E8EFEA 80%); background-size: 200% 100%; animation: skeleton 1.2s ease-in-out infinite; }
.skeleton-short { width: 180rpx; height: 24rpx; }
.skeleton-amount { width: 440rpx; max-width: 88%; height: 96rpx; margin-top: 36rpx; }
.skeleton-copy { width: 520rpx; max-width: 92%; height: 28rpx; margin-top: 46rpx; }
@keyframes skeleton { 0% { background-position: 100% 0; } 100% { background-position: -100% 0; } }

.error-card { display: flex; flex-direction: column; align-items: flex-start; }
.error-card__title { font-size: 32rpx; font-weight: 700; }
.error-card__copy { margin-top: 12rpx; color: #52645B; font-size: 25rpx; line-height: 1.6; }

.drawer-layer { position: fixed; z-index: 100; inset: 0; }
.drawer-mask { position: absolute; inset: 0; background: rgba(15, 31, 24, 0.42); animation: fade-in 180ms ease; }
.settings-drawer { position: absolute; right: 0; bottom: 0; left: 0; box-sizing: border-box; max-height: 92vh; padding: 16rpx 32rpx 0; border-radius: 44rpx 44rpx 0 0; background: #FFFFFF; box-shadow: 0 -24rpx 70rpx rgba(22, 35, 29, 0.16); animation: drawer-in 220ms ease-out; }
.drawer-handle { width: 72rpx; height: 8rpx; margin: 0 auto 24rpx; border-radius: 999rpx; background: #D5DFD8; }
.drawer-header { display: flex; align-items: flex-start; justify-content: space-between; padding-bottom: 24rpx; }
.drawer-eyebrow { color: #16805F; }
.drawer-title { margin-top: 8rpx; font-size: 40rpx; font-weight: 750; }
.drawer-close { min-height: 72rpx; line-height: 68rpx; }
.drawer-scroll { box-sizing: border-box; max-height: calc(92vh - 160rpx); padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); }
.form-field { margin-top: 26rpx; }
.form-field:first-child { margin-top: 6rpx; }
.local-only-note { display: flex; align-items: center; margin-top: 30rpx; padding: 22rpx 24rpx; border-radius: 22rpx; background: #EDF7F1; color: #52645B; font-size: 23rpx; }
.local-only-note__dot { flex: none; width: 14rpx; height: 14rpx; margin-right: 14rpx; border-radius: 50%; background: #20A878; }
.drawer-save { margin-top: 28rpx; }
.reset-button { min-height: 88rpx; margin: 18rpx 0 0; background: transparent; color: #C84F4A; font-size: 24rpx; line-height: 88rpx; }
.reset-button:active { opacity: 0.72; }

@keyframes fade-in { from { opacity: 0; } to { opacity: 1; } }
@keyframes drawer-in { from { transform: translateY(100%); } to { transform: translateY(0); } }

@media (max-width: 340px) {
  .page-shell { padding-right: 24rpx; padding-left: 24rpx; }
  .hero-card { padding-right: 30rpx; padding-left: 30rpx; }
  .metric-label { font-size: 19rpx; }
  .metric-value { font-size: 22rpx; }
  .share-actions { flex-direction: column; }
  .share-button + .share-button { margin-top: 14rpx; margin-left: 0; }
}

@media (prefers-reduced-motion: reduce) {
  .skeleton,
  .drawer-mask,
  .settings-drawer {
    animation: none;
  }

  .primary-button,
  .amount-field,
  .form-input {
    transition: none;
  }
}
