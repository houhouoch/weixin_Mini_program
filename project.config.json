      },
      {
        "type": "folder",
        "value": "specs"
      },
      {
        "type": "folder",
        "value": "tests"
      },
      {
        "type": "file",
        "value": "AGENTS.md"
      },
      {
        "type": "file",
        "value": "Agent.md"
      },
      {
        "type": "file",
        "value": "README.md"
      }
    ],
    "include": []
  }
