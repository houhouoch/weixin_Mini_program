.page-shell {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  min-height: 100vh;
  padding: 24rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
  background: var(--theme-page, #F5F5F7);
  color: var(--theme-text, #1D1D1F);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
}

button {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: inherit;
  line-height: normal;
}

button::after {
  border: 0;
}

button:active {
  opacity: 0.62;
}

button[disabled] {
  opacity: 0.42;
}

.share-entry {
  order: -1;
  box-sizing: border-box;
  margin-bottom: 24rpx;
  padding: 28rpx;
  border: 1rpx solid var(--theme-border, #D2D2D7);
  border-radius: 24rpx;
  background: var(--theme-surface, #FFFFFF);
}

.share-entry__eyebrow,
.share-entry__title,
.share-entry__copy {
  display: block;
}

.share-entry__eyebrow {
  color: var(--theme-primary, #007AFF);
  font-size: 24rpx;
  font-weight: 600;
}

.share-entry__title {
  margin-top: 8rpx;
  font-size: 36rpx;
  font-weight: 650;
  letter-spacing: -1rpx;
}

.share-entry__copy {
  margin-top: 8rpx;
  color: var(--theme-muted, #6E6E73);
  font-size: 26rpx;
  line-height: 1.5;
}

.page-topbar {
  order: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
}

.page-topbar__copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.page-title,
.date-label {
  display: block;
}

.page-title {
  font-size: 40rpx;
  font-weight: 650;
  letter-spacing: -1rpx;
  line-height: 1.2;
}

.date-label {
  margin-top: 5rpx;
  color: var(--theme-muted, #6E6E73);
  font-size: 24rpx;
  line-height: 1.3;
}

.settings-button,
.drawer-close {
  min-width: 88rpx;
  min-height: 88rpx;
  padding: 0 18rpx;
  border-radius: 20rpx;
  background: rgba(120, 120, 128, 0.12);
  color: var(--theme-primary, #007AFF);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.loading-card,
.error-card {
  order: 1;
  box-sizing: border-box;
  margin-top: 20rpx;
  padding: 32rpx;
  border: 1rpx solid var(--theme-border, #D2D2D7);
  border-radius: 24rpx;
  background: var(--theme-surface, #FFFFFF);
}

.loading-card {
  min-height: 320rpx;
}

.skeleton {
  border-radius: 8rpx;
  background: rgba(120, 120, 128, 0.16);
  animation: skeleton-pulse 1.1s ease-in-out infinite alternate;
}

.skeleton-short {
  width: 180rpx;
  height: 24rpx;
}

.skeleton-amount {
  width: 420rpx;
  max-width: 85%;
  height: 86rpx;
  margin-top: 32rpx;
}

.skeleton-copy {
  width: 500rpx;
  max-width: 92%;
  height: 28rpx;
  margin-top: 36rpx;
}

.error-card__title,
.error-card__copy {
  display: block;
}

.error-card__title {
  font-size: 32rpx;
  font-weight: 650;
}

.error-card__copy {
  margin-top: 12rpx;
  color: var(--theme-muted, #6E6E73);
  font-size: 26rpx;
  line-height: 1.55;
}

.hero-card {
  order: 1;
  box-sizing: border-box;
  margin-top: 24rpx;
  padding: 36rpx 32rpx 32rpx;
  border: 1rpx solid var(--theme-border, #D2D2D7);
  border-radius: 24rpx;
  background: var(--theme-surface, #FFFFFF);
}

.hero-content {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.hero-eyebrow,
.hero-amount,
.hero-status,
.hero-badge {
  display: block;
}

.hero-eyebrow {
  color: var(--theme-muted, #6E6E73);
  font-size: 26rpx;
  font-weight: 600;
}

.hero-amount {
  max-width: 100%;
  margin-top: 10rpx;
  overflow-wrap: anywhere;
  color: var(--theme-text, #1D1D1F);
  font-size: 96rpx;
  font-variant-numeric: tabular-nums;
  font-weight: 650;
  letter-spacing: -5rpx;
  line-height: 1.08;
}

.hero-amount.amount-medium {
  font-size: 82rpx;
}

.hero-amount.amount-small {
  font-size: 70rpx;
}

.hero-status {
  display: flex;
  margin-top: 20rpx;
  flex-direction: column;
  color: var(--theme-muted, #6E6E73);
  font-size: 28rpx;
  line-height: 1.5;
}

.hero-badge {
  margin-top: 24rpx;
  padding: 8rpx 14rpx;
  border-radius: 10rpx;
  background: rgba(0, 122, 255, 0.10);
  color: var(--theme-primary, #007AFF);
  font-size: 22rpx;
  font-weight: 650;
  line-height: 1.3;
}

.hero-card--runningLow .hero-amount,
.hero-card--runningLow .hero-badge {
  color: #9A6700;
}

.hero-card--runningLow .hero-badge {
  background: rgba(154, 103, 0, 0.10);
}

.hero-card--monthOverspent .hero-amount,
.hero-card--todayOverspent .hero-amount,
.hero-card--budgetUnavailable .hero-amount,
.hero-card--monthOverspent .hero-badge,
.hero-card--todayOverspent .hero-badge,
.hero-card--budgetUnavailable .hero-badge {
  color: #D70015;
}

.hero-card--monthOverspent .hero-badge,
.hero-card--todayOverspent .hero-badge,
.hero-card--budgetUnavailable .hero-badge {
  background: rgba(215, 0, 21, 0.09);
}

.budget-rail {
  order: 2;
  box-sizing: border-box;
  margin-top: 16rpx;
  padding: 26rpx 28rpx;
  border: 1rpx solid var(--theme-border, #D2D2D7);
  border-radius: 24rpx;
  background: var(--theme-surface, #FFFFFF);
}

.budget-rail__labels {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  color: var(--theme-text, #1D1D1F);
  font-size: 25rpx;
  font-variant-numeric: tabular-nums;
  font-weight: 600;
  line-height: 1.4;
}

.budget-rail__labels text:last-child {
  margin-left: 20rpx;
  text-align: right;
}

.budget-rail__track {
  height: 8rpx;
  margin-top: 20rpx;
  overflow: hidden;
  border-radius: 4rpx;
  background: rgba(120, 120, 128, 0.18);
}

.budget-rail__spent {
  height: 100%;
  min-width: 4rpx;
  border-radius: 4rpx;
  background: var(--theme-primary, #007AFF);
  transition: width 200ms ease;
}

.budget-rail--runningLow .budget-rail__spent {
  background: #9A6700;
}

.budget-rail--monthOverspent .budget-rail__spent,
.budget-rail--todayOverspent .budget-rail__spent,
.budget-rail--budgetUnavailable .budget-rail__spent {
  background: #D70015;
}

.budget-rail__helper,
.budget-rail__cycle,
.budget-rail__income {
  display: block;
  margin-top: 12rpx;
  color: var(--theme-muted, #6E6E73);
  font-size: 23rpx;
  line-height: 1.45;
}

.budget-rail__income {
  color: #248A3D;
}

.record-composer {
  order: 3;
  box-sizing: border-box;
  margin-top: 32rpx;
  padding: 30rpx;
  border: 1rpx solid var(--theme-border, #D2D2D7);
  border-radius: 24rpx;
  background: var(--theme-surface, #FFFFFF);
}

.composer-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.composer-heading > view {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.composer-title,
.review-title,
.receipt-title {
  color: var(--theme-text, #1D1D1F);
  font-size: 34rpx;
  font-weight: 650;
  letter-spacing: -1rpx;
  line-height: 1.3;
}

.composer-heading__summary {
  margin-top: 5rpx;
  color: var(--theme-muted, #6E6E73);
  font-size: 23rpx;
  line-height: 1.4;
}

.composer-heading__privacy {
  flex: none;
  margin-left: 16rpx;
  padding: 7rpx 12rpx;
  border-radius: 9rpx;
  background: rgba(120, 120, 128, 0.10);
  color: var(--theme-muted, #6E6E73);
  font-size: 20rpx;
  font-weight: 600;
}

.composer-body {
  margin-top: 24rpx;
}

.direction-switch,
.fixed-expense-mode {
  display: flex;
  box-sizing: border-box;
  padding: 4rpx;
  border-radius: 20rpx;
  background: rgba(120, 120, 128, 0.12);
}

.direction-switch__button,
.fixed-expense-mode__option {
  display: flex;
  min-height: 80rpx;
  flex: 1;
  align-items: center;
  justify-content: center;
  padding: 0 18rpx;
  border-radius: 16rpx;
  color: var(--theme-muted, #6E6E73);
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.2;
  transition: color 150ms ease, background-color 150ms ease;
}

.direction-switch__button--active,
.fixed-expense-mode__option--active {
  background: var(--theme-surface, #FFFFFF);
  color: var(--theme-text, #1D1D1F);
}

.composer-copy {
  display: block;
  margin-top: 14rpx;
  color: var(--theme-muted, #6E6E73);
  font-size: 23rpx;
  line-height: 1.5;
}

.composer-action-row {
  display: flex;
  align-items: stretch;
  margin-top: 22rpx;
}

.composer-amount {
  display: flex;
  min-width: 0;
  min-height: 96rpx;
  flex: 1;
  align-items: center;
  box-sizing: border-box;
  padding: 0 20rpx;
  border: 1rpx solid var(--theme-border, #D2D2D7);
  border-radius: 20rpx;
  background: rgba(120, 120, 128, 0.06);
  transition: border-color 150ms ease, background-color 150ms ease;
}

.composer-amount:focus-within {
  border-color: var(--theme-primary, #007AFF);
  background: var(--theme-surface, #FFFFFF);
}

.composer-amount > text {
  color: var(--theme-muted, #6E6E73);
  font-size: 34rpx;
  font-weight: 500;
}

.composer-amount__input {
  min-width: 0;
  height: 92rpx;
  flex: 1;
  margin-left: 10rpx;
  color: var(--theme-text, #1D1D1F);
  font-size: 40rpx;
  font-variant-numeric: tabular-nums;
  font-weight: 600;
}

.composer-save {
  min-width: 210rpx;
  min-height: 96rpx;
  margin-left: 14rpx;
  padding: 0 22rpx;
  border-radius: 20rpx;
  background: var(--theme-primary, #007AFF);
  color: var(--theme-on-primary, #FFFFFF);
  font-size: 27rpx;
  font-weight: 650;
  line-height: 96rpx;
}

.composer-save--loading {
  opacity: 0.65;
}

.composer-field--error {
  border-color: #D70015;
  background: rgba(215, 0, 21, 0.04);
}

.composer-feedback {
  margin-top: 12rpx;
}

.composer-details-toggle {
  display: flex;
  width: 100%;
  min-height: 88rpx;
  margin-top: 18rpx;
  align-items: center;
  justify-content: space-between;
  border-top: 1rpx solid var(--theme-border, #D2D2D7);
  color: var(--theme-text, #1D1D1F);
  text-align: left;
}

.composer-details-toggle__copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.composer-details-toggle__copy text:first-child {
  font-size: 25rpx;
  font-weight: 600;
}

.composer-details-toggle__copy text:last-child {
  margin-top: 3rpx;
  color: var(--theme-muted, #6E6E73);
  font-size: 21rpx;
}

.composer-details-toggle__action {
  flex: none;
  margin-left: 18rpx;
  color: var(--theme-primary, #007AFF);
  font-size: 23rpx;
  font-weight: 600;
}

.composer-details {
  padding-top: 2rpx;
}

.quick-templates {
  margin-top: 26rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid var(--theme-border, #D2D2D7);
}

.quick-templates__heading {
  display: flex;
  flex-direction: column;
}

.quick-templates__heading text:first-child {
  font-size: 26rpx;
  font-weight: 650;
}

.quick-templates__heading text:last-child {
  margin-top: 3rpx;
  color: var(--theme-muted, #6E6E73);
  font-size: 21rpx;
}

.quick-template {
  display: flex;
  min-height: 96rpx;
  margin-top: 12rpx;
  overflow: hidden;
  border: 1rpx solid var(--theme-border, #D2D2D7);
  border-radius: 18rpx;
}

.quick-template__use {
  display: flex;
  min-width: 0;
  min-height: 96rpx;
  flex: 1;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 18rpx;
  text-align: left;
}

.quick-template__use > view {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.quick-template__title {
  overflow: hidden;
  font-size: 25rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.quick-template__meta {
  margin-top: 3rpx;
  color: var(--theme-muted, #6E6E73);
  font-size: 20rpx;
}

.quick-template__amount {
  flex: none;
  margin-left: 12rpx;
  color: var(--theme-primary, #007AFF);
  font-size: 27rpx;
  font-variant-numeric: tabular-nums;
  font-weight: 650;
}

.quick-template__delete {
  width: 96rpx;
  min-height: 96rpx;
  border-left: 1rpx solid var(--theme-border, #D2D2D7);
  color: #D70015;
  font-size: 22rpx;
  line-height: 96rpx;
}

.composer-label,
.field-label {
  display: block;
  margin-top: 24rpx;
  margin-bottom: 10rpx;
  color: var(--theme-muted, #6E6E73);
  font-size: 23rpx;
  font-weight: 600;
  line-height: 1.4;
}

.category-grid {
  display: flex;
  flex-wrap: wrap;
  margin: -6rpx;
}

.category-chip {
  min-height: 88rpx;
  width: calc(25% - 12rpx);
  margin: 6rpx;
  padding: 0 8rpx;
  border: 1rpx solid var(--theme-border, #D2D2D7);
  border-radius: 16rpx;
  background: rgba(120, 120, 128, 0.05);
  color: var(--theme-text, #1D1D1F);
  font-size: 23rpx;
  font-weight: 500;
  line-height: 88rpx;
}

.category-chip--selected {
  border-color: var(--theme-primary, #007AFF);
  background: rgba(0, 122, 255, 0.08);
  color: var(--theme-primary, #007AFF);
  font-weight: 650;
}

.purpose-field,
.selector-field,
.edit-date-field {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  width: 100%;
  min-height: 96rpx;
  padding: 0 22rpx;
  border: 1rpx solid var(--theme-border, #D2D2D7);
  border-radius: 18rpx;
  background: rgba(120, 120, 128, 0.05);
  color: var(--theme-text, #1D1D1F);
  font-size: 27rpx;
  line-height: 96rpx;
}

.template-save-button {
  width: 100%;
  min-height: 88rpx;
  margin-top: 16rpx;
  color: var(--theme-primary, #007AFF);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.field-error,
.field-success,
.field-helper {
  display: block;
  font-size: 22rpx;
  line-height: 1.5;
}

.field-error {
  color: #D70015;
}

.field-success {
  color: #248A3D;
}

.field-helper {
  margin-top: 10rpx;
  color: var(--theme-muted, #6E6E73);
}

.review-card {
  order: 4;
}

.receipt-card {
  order: 5;
}

.review-card,
.receipt-card {
  box-sizing: border-box;
  margin-top: 20rpx;
  overflow: hidden;
  border: 1rpx solid var(--theme-border, #D2D2D7);
  border-radius: 24rpx;
  background: var(--theme-surface, #FFFFFF);
}

.section-toggle {
  display: flex;
  width: 100%;
  min-height: 112rpx;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 28rpx;
  text-align: left;
}

.section-toggle__copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.section-toggle__summary {
  margin-top: 4rpx;
  overflow: hidden;
  color: var(--theme-muted, #6E6E73);
  font-size: 22rpx;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.section-toggle__action {
  flex: none;
  min-width: 72rpx;
  margin-left: 16rpx;
  color: var(--theme-primary, #007AFF);
  font-size: 24rpx;
  font-weight: 600;
  text-align: right;
}

.fold-content {
  padding: 0 28rpx 28rpx;
  border-top: 1rpx solid var(--theme-border, #D2D2D7);
  animation: fold-in 180ms ease-out;
}

.review-subtitle {
  display: block;
  padding-top: 22rpx;
  color: var(--theme-muted, #6E6E73);
  font-size: 23rpx;
  line-height: 1.5;
}

.review-tabs {
  display: flex;
  margin-top: 18rpx;
  padding: 4rpx;
  border-radius: 18rpx;
  background: rgba(120, 120, 128, 0.12);
}

.review-tab {
  min-width: 0;
  min-height: 80rpx;
  flex: 1;
  border-radius: 14rpx;
  color: var(--theme-muted, #6E6E73);
  font-size: 23rpx;
  font-weight: 600;
  line-height: 80rpx;
}

.review-tab--active {
  background: var(--theme-surface, #FFFFFF);
  color: var(--theme-text, #1D1D1F);
}

.review-range {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
}

.review-range__picker {
  min-width: 0;
  flex: 1;
}

.review-range__field {
  box-sizing: border-box;
  min-height: 96rpx;
  padding: 14rpx 16rpx;
  border: 1rpx solid var(--theme-border, #D2D2D7);
  border-radius: 16rpx;
}

.review-range__label,
.review-range__value {
  display: block;
}

.review-range__label {
  color: var(--theme-muted, #6E6E73);
  font-size: 20rpx;
}

.review-range__value {
  margin-top: 4rpx;
  font-size: 24rpx;
  font-variant-numeric: tabular-nums;
  font-weight: 600;
}

.review-range__separator {
  margin: 0 10rpx;
  color: var(--theme-muted, #6E6E73);
  font-size: 22rpx;
}

.review-loading,
.review-error,
.history-loading,
.history-error {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: rgba(120, 120, 128, 0.08);
  color: var(--theme-muted, #6E6E73);
  font-size: 23rpx;
  line-height: 1.5;
}

.review-error,
.history-error {
  background: rgba(215, 0, 21, 0.06);
  color: #D70015;
}

.review-metrics {
  display: flex;
  flex-wrap: wrap;
  margin: 14rpx -6rpx -6rpx;
}

.review-metric {
  box-sizing: border-box;
  width: calc(50% - 12rpx);
  margin: 6rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: rgba(120, 120, 128, 0.07);
}

.review-metric__label,
.review-metric__value {
  display: block;
}

.review-metric__label {
  color: var(--theme-muted, #6E6E73);
  font-size: 21rpx;
}

.review-metric__value {
  margin-top: 5rpx;
  font-size: 30rpx;
  font-variant-numeric: tabular-nums;
  font-weight: 650;
}

.weekly-summary {
  margin-top: 18rpx;
  padding: 22rpx;
  border: 1rpx solid var(--theme-border, #D2D2D7);
  border-radius: 18rpx;
}

.weekly-summary__heading,
.weekly-summary__insights {
  display: flex;
  flex-direction: column;
}

.weekly-summary__title {
  font-size: 27rpx;
  font-weight: 650;
}

.weekly-summary__scope,
.weekly-summary__comparison,
.weekly-summary__insights {
  color: var(--theme-muted, #6E6E73);
  font-size: 21rpx;
  line-height: 1.45;
}

.weekly-summary__scope {
  margin-top: 4rpx;
}

.weekly-summary__totals {
  display: flex;
  margin-top: 16rpx;
  border-top: 1rpx solid var(--theme-border, #D2D2D7);
  border-bottom: 1rpx solid var(--theme-border, #D2D2D7);
}

.weekly-summary__totals > view {
  display: flex;
  flex: 1;
  flex-direction: column;
  padding: 14rpx 0;
}

.weekly-summary__totals > view + view {
  padding-left: 18rpx;
  border-left: 1rpx solid var(--theme-border, #D2D2D7);
}

.weekly-summary__totals text:first-child {
  color: var(--theme-muted, #6E6E73);
  font-size: 20rpx;
}

.weekly-summary__totals text:last-child {
  margin-top: 4rpx;
  font-size: 28rpx;
  font-variant-numeric: tabular-nums;
