}

.theme-scroll {
  margin-top: 18rpx;
}

.theme-preset-grid {
  display: flex;
  flex-wrap: wrap;
  margin: -6rpx;
}

.theme-preset {
  display: flex;
  box-sizing: border-box;
  width: calc(33.333% - 12rpx);
  min-height: 140rpx;
  margin: 6rpx;
  padding: 16rpx 12rpx;
  border: 1rpx solid var(--theme-border, #D2D2D7);
  border-radius: 16rpx;
  flex-direction: column;
  justify-content: center;
  color: var(--theme-text, #1D1D1F);
  font-size: 21rpx;
  font-weight: 600;
  line-height: 1.3;
  text-align: left;
}

.theme-preset--selected {
  border-color: var(--theme-primary, #007AFF);
  background: rgba(0, 122, 255, 0.06);
  color: var(--theme-primary, #007AFF);
}

.theme-swatches {
  display: flex;
  margin-bottom: 12rpx;
}

.theme-swatch {
  width: 30rpx;
  height: 30rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(0, 0, 0, 0.10);
  border-radius: 15rpx;
}

.theme-swatch + .theme-swatch {
  margin-left: 5rpx;
}

.theme-advanced {
  margin-top: 22rpx;
  padding: 22rpx;
  border: 1rpx solid var(--theme-border, #D2D2D7);
  border-radius: 20rpx;
}

.theme-advanced__title {
  display: block;
  font-size: 26rpx;
  font-weight: 650;
}

.theme-control {
  margin-top: 18rpx;
}

.theme-control__heading {
  display: flex;
  justify-content: space-between;
  color: var(--theme-muted, #6E6E73);
  font-size: 21rpx;
}

.theme-control slider {
  margin: 2rpx 0 0;
}

.theme-safety-note {
  color: var(--theme-muted, #6E6E73);
  font-size: 21rpx;
  line-height: 1.5;
}

.theme-actions {
  display: flex;
  margin-top: 18rpx;
}

.theme-action {
  min-height: 96rpx;
  flex: 1;
  padding: 0 12rpx;
  border-radius: 18rpx;
  font-size: 25rpx;
  font-weight: 650;
  line-height: 96rpx;
}

.theme-action + .theme-action {
  margin-left: 12rpx;
}

.theme-action--secondary {
  border: 1rpx solid var(--theme-border, #D2D2D7);
  color: var(--theme-primary, #007AFF);
}

.theme-action--primary {
  background: var(--theme-primary, #007AFF);
  color: var(--theme-on-primary, #FFFFFF);
}

@keyframes skeleton-pulse {
  from { opacity: 0.45; }
  to { opacity: 1; }
}

@keyframes fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes drawer-in {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

@keyframes fold-in {
  from {
    opacity: 0;
    transform: translateY(-8rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (max-width: 375px) {
  .page-shell {
    padding-right: 28rpx;
    padding-left: 28rpx;
  }

  .hero-amount {
    font-size: 86rpx;
  }

  .hero-amount.amount-medium {
    font-size: 76rpx;
  }

  .hero-amount.amount-small {
    font-size: 66rpx;
  }

  .record-composer,
  .hero-card {
    padding-right: 26rpx;
    padding-left: 26rpx;
  }

  .composer-save {
    min-width: 190rpx;
    padding-right: 14rpx;
    padding-left: 14rpx;
    font-size: 25rpx;
  }

  .category-chip {
    font-size: 22rpx;
  }
}

@media (max-width: 340px) {
  .page-shell {
    padding-right: 24rpx;
    padding-left: 24rpx;
  }

  .composer-action-row {
    flex-direction: column;
  }

  .composer-save {
    width: 100%;
    margin-top: 12rpx;
    margin-left: 0;
  }

  .category-chip {
    width: calc(50% - 12rpx);
  }

  .budget-rail__labels,
  .history-toolbar {
    flex-direction: column;
  }

  .budget-rail__labels text:last-child {
    margin-top: 6rpx;
    margin-left: 0;
    text-align: left;
  }

  .history-date-button {
    margin-top: 10rpx;
    margin-left: 0;
  }

  .record-row {
    align-items: flex-start;
    flex-wrap: wrap;
  }

  .record-tail {
    width: 100%;
    align-items: flex-end;
    margin-top: 8rpx;
    margin-left: 0;
  }

  .theme-preset {
    width: calc(50% - 12rpx);
  }
}

@media (prefers-reduced-motion: reduce) {
  .skeleton,
  .drawer-mask,
  .settings-drawer,
  .theme-drawer,
  .edit-drawer,
  .fold-content {
    animation: none;
  }

  .budget-rail__spent,
  .direction-switch__button,
  .fixed-expense-mode__option,
  .composer-amount,
  .form-input,
  .review-bar__fill {
    transition: none;
  }
}
